I18N.RDict, I18N.RFrags = {}, {}
for K, V in pairs(I18N.Dict) do
    if I18N.RDict[V] == nil then I18N.RDict[V] = K end
end
I18N.RDict["Figure"] = nil
-- nhãn vật phẩm dạng "Tên [Code]": khi chuyển ngược về tiếng Việt thì trả lại đủ nhãn gốc
for Vi, En in pairs(I18N.Dict) do
    for _, Code in ipairs({ "Lighter", "Flashlight", "Lockpick", "Vitamins", "Bandage", "Battery", "Candle", "Crucifix", "Glowsticks",
        "SkeletonKey", "Bread", "Cheese", "Shears", "Smoothie", "Multitool", "Key", "GeneratorFuse" }) do
        if string.lower((string.gsub(En, "%s", ""))) == string.lower(Code) then
            I18N.RDict[En] = Vi .. " [" .. Code .. "]"
        end
    end
end
for _, Pair in ipairs(I18N.Frags) do
    table.insert(I18N.RFrags, { Pair[2], Pair[1] })
end
table.sort(I18N.RFrags, function(A, B) return #A[1] > #B[1] end)
function I18N.Convert(Text, ToEn)
    if type(Text) ~= "string" or Text == "" then return Text end
    local Dict, Frags = I18N.RDict, I18N.RFrags
    if ToEn then Dict, Frags = I18N.Dict, I18N.Frags end
    local Exact = Dict[Text]
    if Exact then return Exact end
    -- nhãn vật phẩm dạng "Tên [CodeName]" (vd. "Cậy cửa [Lockpick]") -> "Lockpick"
    if ToEn and string.find(Text, "[", 1, true) then
        Text = string.gsub(Text, "([^,%[%]]+) %[([%w_]+)%]", function(Raw, Code)
            local Lead, Left = string.match(Raw, "^(%s*)(.-)$")
            local Tr = Dict[Left]
            if not Tr then return nil end
            if string.lower((string.gsub(Tr, "%s", ""))) == string.lower(Code) then return Lead .. Tr end
            return Lead .. Tr .. " [" .. Code .. "]"
        end)
    end
    for _, Pair in ipairs(Frags) do
        local Start, Stop = string.find(Text, Pair[1], 1, true)
        while Start do
            Text = string.sub(Text, 1, Start - 1) .. Pair[2] .. string.sub(Text, Stop + 1)
            Start, Stop = string.find(Text, Pair[1], Start + #Pair[2], true)
        end
    end
    return Text
end
function I18N.Tr(Text)
    if I18N.Lang ~= "en" then return Text end
    return I18N.Convert(Text, true)
end
function I18N.Save()
    pcall(function() if typeof(writefile) == "function" then writefile(I18N.File, I18N.Lang) end end)
end
function I18N.Load()
    pcall(function()
        if typeof(isfile) == "function" and isfile(I18N.File) then
            local V = string.gsub(readfile(I18N.File), "%s", "")
            if V == "en" or V == "vi" then I18N.Lang = V end
        end
    end)
end

return I18N
