        local function FetchFriendCount(userId, cb)
            local cached = friendCache[userId]
            if cached ~= nil then
                cb(cached or nil)
                return
            end
            task.spawn(function()
                local ok, n = pcall(function()
                    local pages = Players:GetFriendsAsync(userId)
                    local total = 0
                    for _ = 1, 15 do
                        total = total + #pages:GetCurrentPage()
                        if pages.IsFinished then break end
                        pages:AdvanceToNextPageAsync()
                    end
                    return total
                end)
                friendCache[userId] = ok and n or false
                cb(ok and n or nil)
            end)
        end

