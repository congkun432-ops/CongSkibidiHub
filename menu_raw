function Library:Notify(config)
    if type(config) ~= "table" then
        config = { Content = tostring(config or "") }
    end

    local typeKey  = config.Type or config.type
    local typeInfo = typeKey and NOTIFY_TYPES[string.lower(tostring(typeKey))] or nil

    local Title    = config.Title or config.title or (typeInfo and typeInfo.Title) or "Thông Báo"
    local Content  = config.Content or config.content or config.Message or config.message or ""
    local Duration = config.Duration or config.duration or 4
    local Accent   = config.Color or config.color or (typeInfo and typeInfo.Color) or ACCENT
    local Silent   = config.Silent or config.silent or false
    local SoundId  = config.SoundId or config.soundId

    if typeInfo then Title = typeInfo.Icon .. "  " .. Title end
    if type(Duration) ~= "number" or Duration <= 0 then Duration = 4 end
    Content = tostring(Content)

    local gui       = EnsureNotifyGui()
    local Container = gui:FindFirstChild("Container")
    if not Container then return nil end

    if not Silent then
        local now = tick()
        if now - lastNotifySound > 0.25 then
            lastNotifySound = now
            PlayNotifySound(SoundId)
        end
    end

    notifySlot = notifySlot + 1

    local TEXT_W = 262
    local contentHeight = 14
    if #Content > 0 then
        local ok, bounds = pcall(function()
            return TextService:GetTextSize(Content, 11, Enum.Font.GothamMedium, Vector2.new(TEXT_W, 1000))
        end)
        if ok and bounds then
            contentHeight = math.max(14, bounds.Y)
        end
    end
    local totalHeight = math.max(40, 19 + contentHeight + 11)

    local Holder = New("Frame", {
        Name = "Holder",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        LayoutOrder = notifySlot,
        ClipsDescendants = false
    }, Container)

    local Notif = New("Frame", {
        Name = "Notif",
        Size = UDim2.new(1, 0, 0, totalHeight),
        Position = UDim2.new(1, 340, 0, 0),
        BackgroundColor3 = BG_PANEL,
        BackgroundTransparency = 1,
        ZIndex = 2
    }, Holder)
    Corner(Notif, UDim.new(0, 7))

    local NotifStroke = Stroke(Notif, Accent, 1.2, 1)
    NotifStroke.ZIndex = 3

    local AccentBar = New("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundColor3 = Accent,
        BackgroundTransparency = 1,
        ZIndex = 3
    }, Notif)
    Corner(AccentBar, UDim.new(1, 0))

    local TitleLbl = New("TextLabel", {
        Size = UDim2.new(1, -18, 0, 16),
        Position = UDim2.new(0, 13, 0, 3),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Accent,
        TextTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3
    }, Notif)

    local ContentLbl = New("TextLabel", {
        Size = UDim2.new(1, -18, 0, contentHeight),
        Position = UDim2.new(0, 13, 0, 20),
        BackgroundTransparency = 1,
        Text = Content,
        TextColor3 = Color3.fromRGB(220, 220, 220),
        TextTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 3
    }, Notif)

    local BarTrack = New("Frame", {
        Size = UDim2.new(1, -20, 0, 3),
        Position = UDim2.new(0, 10, 1, -7),
        BackgroundColor3 = BG_OFF,
        BackgroundTransparency = 1,
        ZIndex = 3
    }, Notif)
    Corner(BarTrack, UDim.new(1, 0))

    local BarFill = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Accent,
        BackgroundTransparency = 1,
        ZIndex = 4
    }, BarTrack)
    Corner(BarFill, UDim.new(1, 0))

    local slideIn  = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local fadeIn   = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local growInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    local dismissed = false

    local function Dismiss()
        if dismissed then return end
        dismissed = true

        for i, fn in ipairs(activeNotifs) do
            if fn == Dismiss then
                table.remove(activeNotifs, i)
                break
            end
        end

        task.spawn(function()
            if not Notif or not Notif.Parent then return end

            local outInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            local outFade = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            Tween(Notif, outInfo, { Position = UDim2.new(1, 340, 0, 0) })
            Tween(Notif, outFade, { BackgroundTransparency = 1 })
            Tween(NotifStroke, outFade, { Transparency = 1 })
            Tween(AccentBar, outFade, { BackgroundTransparency = 1 })
            Tween(TitleLbl, outFade, { TextTransparency = 1 })
            Tween(ContentLbl, outFade, { TextTransparency = 1 })
            Tween(BarTrack, outFade, { BackgroundTransparency = 1 })
            Tween(BarFill, outFade, { BackgroundTransparency = 1 })

            task.wait(0.35)
            if not Holder or not Holder.Parent then return end

            local collapse = Tween(Holder, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 0)
            })
            collapse.Completed:Wait()
            if Holder and Holder.Parent then Holder:Destroy() end
        end)
    end

    table.insert(activeNotifs, Dismiss)
    while #activeNotifs > MAX_NOTIFS do
        local oldest = table.remove(activeNotifs, 1)
        if oldest then oldest() end
    end

    Tween(Holder, growInfo, { Size = UDim2.new(1, 0, 0, totalHeight) })

    task.delay(0.08, function()
        if dismissed or not Notif or not Notif.Parent then return end
        Tween(Notif, slideIn, { Position = UDim2.new(0, 0, 0, 0) })
        Tween(Notif, fadeIn, { BackgroundTransparency = 0 })
        Tween(NotifStroke, fadeIn, { Transparency = 0.35 })
        Tween(AccentBar, fadeIn, { BackgroundTransparency = 0 })
        Tween(TitleLbl, fadeIn, { TextTransparency = 0 })
        Tween(ContentLbl, fadeIn, { TextTransparency = 0 })
        Tween(BarTrack, fadeIn, { BackgroundTransparency = 0.3 })
        Tween(BarFill, fadeIn, { BackgroundTransparency = 0 })
    end)

    task.delay(0.55, function()
        if dismissed or not BarFill or not BarFill.Parent then return end
        Tween(BarFill, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0)
        })
    end)

    task.delay(0.55 + Duration, Dismiss)

    return Notif
end

local function MakeShortcut(typeName)
    return function(self, title, content, duration)
        return Library:Notify({
            Type = typeName,
            Title = title,
            Content = content,
            Duration = duration
        })
    end
end

Library.Info    = MakeShortcut("info")
Library.Success = MakeShortcut("success")
Library.Warning = MakeShortcut("warning")
Library.Error   = MakeShortcut("error")

