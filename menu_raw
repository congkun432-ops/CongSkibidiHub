-- [[ CYBERVIBE UI LIBRARY MODULE ]]
local Library = {}

function Library:CreateWindow(config)
    if type(config) ~= "table" then config = {} end
    local HubName = tostring(config.HubName or "Setchauphi")
    local AuthorName = tostring(config.AuthorName or "Courier cat")

    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local Players = game:GetService("Players")

    -- [FIX] Safe parent GUI (CoreGui có thể bị chặn / nil)
    local parentGui
    local coreGui = game:GetService("CoreGui")
    if coreGui then
        local ok = pcall(function()
            local test = Instance.new("ScreenGui")
            test.Parent = coreGui
            test:Destroy()
        end)
        if ok then parentGui = coreGui end
    end
    if not parentGui then
        local player = Players.LocalPlayer
        if not player then
            error("CyberVibe: CreateWindow phải được gọi từ LocalScript (client).")
        end
        parentGui = player:WaitForChild("PlayerGui")
    end

    -- [FIX] Xoá hub cũ (tránh tạo nhiều ScreenGui cùng tên + nhiều vòng lặp rainbow)
    do
        local existing = parentGui:FindFirstChild("CyberVibe_Hub")
        if existing then pcall(function() existing:Destroy() end) end
    end

    -- ScreenGui Chứa Toàn Bộ UI
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CyberVibe_Hub"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = parentGui

    -- Mobile Toggle Button (Mini Menu)
    local MobileToggle = Instance.new("TextButton", ScreenGui)
    MobileToggle.Size = UDim2.new(0, 65, 0, 65)
    MobileToggle.Position = UDim2.new(0, 15, 0, 15)
    MobileToggle.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
    MobileToggle.Text = ""
    MobileToggle.Draggable = true
    MobileToggle.Visible = true
    Instance.new("UICorner", MobileToggle).CornerRadius = UDim.new(1, 0)
    local ToggleStroke = Instance.new("UIStroke", MobileToggle); ToggleStroke.Thickness = 2
    local ToggleIcon = Instance.new("ImageLabel", MobileToggle)
    ToggleIcon.Size = UDim2.new(1, 0, 1, 0)
    ToggleIcon.BackgroundTransparency = 1
    ToggleIcon.Image = "rbxassetid://134586557209278"
    ToggleIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    ToggleIcon.ScaleType = Enum.ScaleType.Fit
    Instance.new("UICorner", ToggleIcon).CornerRadius = UDim.new(1, 0)

    -- Main Frame
    local MainFrame = Instance.new("Frame", ScreenGui)
    local FULL_SIZE = UDim2.new(0, 460, 0, 320)
    local MINI_SIZE = UDim2.new(0, 460, 0, 38)
    MainFrame.Size = FULL_SIZE
    MainFrame.Position = UDim2.new(0.5, -230, 0.5, -160)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 22, 27)
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false
    MainFrame.BackgroundTransparency = 1
    MainFrame.ClipsDescendants = true

    local MainStroke = Instance.new("UIStroke", MainFrame); MainStroke.Thickness = 1.5
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

    -- Control Buttons (X, –, D)
    local CloseBtn = Instance.new("TextButton", MainFrame)
    CloseBtn.Size = UDim2.new(0, 28, 0, 28); CloseBtn.Position = UDim2.new(1, -38, 0, 10)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(250, 60, 60); CloseBtn.Text = "X"; CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.Font = Enum.Font.GothamBold; CloseBtn.TextSize = 14
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

    local MinimizeBtn = Instance.new("TextButton", MainFrame)
    MinimizeBtn.Size = UDim2.new(0, 28, 0, 28); MinimizeBtn.Position = UDim2.new(1, -72, 0, 10)
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(54, 59, 72); MinimizeBtn.Text = "–"; MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinimizeBtn.Font = Enum.Font.GothamBold; MinimizeBtn.TextSize = 14
    Instance.new("UICorner", MinimizeBtn).CornerRadius = UDim.new(0, 6)

    local DestroyBtn = Instance.new("TextButton", MainFrame)
    DestroyBtn.Size = UDim2.new(0, 28, 0, 28); DestroyBtn.Position = UDim2.new(1, -106, 0, 10)
    DestroyBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40); DestroyBtn.Text = "D"; DestroyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    DestroyBtn.Font = Enum.Font.GothamBold; DestroyBtn.TextSize = 13
    Instance.new("UICorner", DestroyBtn).CornerRadius = UDim.new(0, 6)

    -- Header Title
    local TitleLabel = Instance.new("TextLabel", MainFrame)
    TitleLabel.Size = UDim2.new(1, -50, 0, 40); TitleLabel.Position = UDim2.new(0, 15, 0, 0); TitleLabel.BackgroundTransparency = 1
    TitleLabel.Font = Enum.Font.GothamBold; TitleLabel.TextSize = 14; TitleLabel.TextXAlignment = 0

    -- [FIX] Dùng os.clock thay tick (tick deprecated), và tự dừng khi ScreenGui chết
    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            local hue = (os.clock() % 6) / 6
            local rainbow = Color3.fromHSV(hue, 0.7, 1)
            if MainStroke and MainStroke.Parent then MainStroke.Color = rainbow end
            if TitleLabel and TitleLabel.Parent then
                TitleLabel.TextColor3 = rainbow
                TitleLabel.Text = "🔮  " .. HubName .. "  |  By: " .. AuthorName
            end
            if ToggleStroke and ToggleStroke.Parent then ToggleStroke.Color = rainbow end
            task.wait(0.03)
        end
    end)

    -- Containers
    local TabContainer = Instance.new("Frame", MainFrame)
    TabContainer.Size = UDim2.new(0, 110, 1, -55); TabContainer.Position = UDim2.new(0, 12, 0, 45); TabContainer.BackgroundTransparency = 1
    local TabList = Instance.new("UIListLayout", TabContainer); TabList.Padding = UDim.new(0, 6)

    local ContentContainer = Instance.new("Frame", MainFrame)
    ContentContainer.Size = UDim2.new(1, -145, 1, -55); ContentContainer.Position = UDim2.new(0, 133, 0, 45); ContentContainer.BackgroundTransparency = 1

    -- State variables
    local isMinimized = false
    local isMenuVisible = false
    local userToggled = false

    -- [FIX] Token chống race condition khi open/close liên tục
    local animToken = 0
    local function newAnimToken()
        animToken = animToken + 1
        return animToken
    end
    local function isValidToken(t)
        return t == animToken and ScreenGui.Parent ~= nil
    end

    -- Hiệu ứng mở menu với animation
    local function OpenMenu()
        if isMenuVisible or not ScreenGui.Parent then return end
        isMenuVisible = true
        local myToken = newAnimToken()

        MainFrame.Visible = true
        MainFrame.ClipsDescendants = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.BackgroundTransparency = 1

        -- Reset trạng thái minimize khi mở menu
        if isMinimized then
            isMinimized = false
            MinimizeBtn.Text = "–"
            TabContainer.Visible = true
            ContentContainer.Visible = true
        end

        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0), {
            Size = FULL_SIZE,
            Position = UDim2.new(0.5, -230, 0.5, -160)
        }):Play()
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0
        }):Play()

        -- [FIX] Chờ tween xong mới mở clip để dropdown/glow không bị cắt,
        -- và kiểm tra token để tránh chạy sai khi user đóng/mở liên tục.
        task.wait(0.5)
        if not isValidToken(myToken) then return end
        MainFrame.ClipsDescendants = false

        -- Hiệu ứng glow khi mở (tạo sau khi hết clip)
        local glowFrame = Instance.new("Frame", MainFrame)
        glowFrame.Size = UDim2.new(1, 0, 1, 0)
        glowFrame.Position = UDim2.new(0, 0, 0, 0)
        glowFrame.BackgroundColor3 = Color3.fromRGB(0, 212, 255)
        glowFrame.BackgroundTransparency = 0.6
        glowFrame.ZIndex = 0
        Instance.new("UICorner", glowFrame).CornerRadius = UDim.new(0, 10)

        TweenService:Create(glowFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 16, 1, 16),
            Position = UDim2.new(0, -8, 0, -8)
        }):Play()
        task.delay(0.5, function()
            if glowFrame and glowFrame.Parent then glowFrame:Destroy() end
        end)
    end

    -- Hiệu ứng đóng menu
    local function CloseMenu()
        if not isMenuVisible then return end
        isMenuVisible = false
        isMinimized = false
        MinimizeBtn.Text = "–"
        TabContainer.Visible = true
        ContentContainer.Visible = true

        -- [FIX] Bật clip trong lúc đóng để children không tràn ra ngoài
        MainFrame.ClipsDescendants = true
        newAnimToken() -- vô hiệu token cũ

        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        task.wait(0.3)
        if not ScreenGui.Parent then return end
        MainFrame.Visible = false
        MainFrame.Size = FULL_SIZE
        MainFrame.Position = UDim2.new(0.5, -230, 0.5, -160)
        MainFrame.ClipsDescendants = true
    end

    -- Mobile Toggle
    MobileToggle.MouseButton1Click:Connect(function()
        userToggled = true
        if isMenuVisible then
            CloseMenu()
        else
            OpenMenu()
        end
    end)

    -- Close Button (X)
    CloseBtn.MouseButton1Click:Connect(function()
        CloseMenu()
    end)

    -- Minimize Button
    MinimizeBtn.MouseButton1Click:Connect(function()
        if not isMenuVisible or not ScreenGui.Parent then return end
        isMinimized = not isMinimized

        if isMinimized then
            MainFrame.ClipsDescendants = true
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = MINI_SIZE
            }):Play()
            MinimizeBtn.Text = "+"
            TabContainer.Visible = false
            ContentContainer.Visible = false
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = FULL_SIZE
            }):Play()
            MinimizeBtn.Text = "–"
            TabContainer.Visible = true
            ContentContainer.Visible = true
            -- [FIX] Chờ resize xong mới tắt clip
            task.delay(0.3, function()
                if ScreenGui.Parent and isMenuVisible and not isMinimized then
                    MainFrame.ClipsDescendants = false
                end
            end)
        end
    end)

    -- Destroy Menu với hộp thoại xác nhận đầy đủ
    local confirmOpen = false
    DestroyBtn.MouseButton1Click:Connect(function()
        -- [FIX] Chặn mở nhiều hộp xác nhận
        if confirmOpen or not ScreenGui.Parent then return end
        confirmOpen = true

        local ConfirmFrame = Instance.new("Frame", ScreenGui)
        ConfirmFrame.Size = UDim2.new(0, 280, 0, 140)
        ConfirmFrame.Position = UDim2.new(0.5, -140, 0.5, -70)
        ConfirmFrame.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
        ConfirmFrame.ZIndex = 100
        Instance.new("UICorner", ConfirmFrame).CornerRadius = UDim.new(0, 10)
        local ConfirmStroke = Instance.new("UIStroke", ConfirmFrame)
        ConfirmStroke.Color = Color3.fromRGB(0, 212, 255)
        ConfirmStroke.Thickness = 1.5

        local Title = Instance.new("TextLabel", ConfirmFrame)
        Title.Size = UDim2.new(1, 0, 0, 35)
        Title.Position = UDim2.new(0, 0, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Text = "⚠️ Xác Nhận Xóa"
        Title.TextColor3 = Color3.fromRGB(255, 80, 80)
        Title.Font = Enum.Font.GothamBold
        Title.TextSize = 16

        local TextLabel = Instance.new("TextLabel", ConfirmFrame)
        TextLabel.Size = UDim2.new(1, -20, 0, 40)
        TextLabel.Position = UDim2.new(0, 10, 0, 40)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Text = "Bạn có chắc chắn muốn\nXÓA HOÀN TOÀN menu này không?"
        TextLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        TextLabel.Font = Enum.Font.GothamMedium
        TextLabel.TextSize = 13
        TextLabel.TextScaled = false
        TextLabel.TextXAlignment = 1

        local YesBtn = Instance.new("TextButton", ConfirmFrame)
        YesBtn.Size = UDim2.new(0, 110, 0, 34)
        YesBtn.Position = UDim2.new(0.08, 0, 0.75, 0)
        YesBtn.BackgroundColor3 = Color3.fromRGB(250, 60, 60)
        YesBtn.Text = "Xác Nhận Xóa"
        YesBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        YesBtn.Font = Enum.Font.GothamBold
        YesBtn.TextSize = 13
        Instance.new("UICorner", YesBtn).CornerRadius = UDim.new(0, 6)

        local NoBtn = Instance.new("TextButton", ConfirmFrame)
        NoBtn.Size = UDim2.new(0, 110, 0, 34)
        NoBtn.Position = UDim2.new(0.56, 0, 0.75, 0)
        NoBtn.BackgroundColor3 = Color3.fromRGB(50, 53, 65)
        NoBtn.Text = "Hủy Bỏ"
        NoBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        NoBtn.Font = Enum.Font.GothamBold
        NoBtn.TextSize = 13
        Instance.new("UICorner", NoBtn).CornerRadius = UDim.new(0, 6)

        NoBtn.MouseButton1Click:Connect(function()
            confirmOpen = false
            ConfirmFrame:Destroy()
        end)

        YesBtn.MouseButton1Click:Connect(function()
            -- Huỷ mọi animation đang chạy
            newAnimToken()
            TweenService:Create(ConfirmFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }):Play()
            task.wait(0.2)
            if ConfirmFrame and ConfirmFrame.Parent then ConfirmFrame:Destroy() end
            if not ScreenGui.Parent then return end
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }):Play()
            task.wait(0.3)
            if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
        end)
    end)

    -- [FIX] Tránh tự động mở đè nếu user đã tự tay bấm toggle trong 0.1s đầu
    task.wait(0.1)
    if not userToggled and not isMenuVisible and ScreenGui.Parent then
        OpenMenu()
    end

    local Window = { Pages = {}, TabButtons = {} }

    function Window:CreateTab(name)
        name = tostring(name or "Tab")

        local Page = Instance.new("ScrollingFrame", ContentContainer)
        Page.Name = name .. "Page"
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 3
        Page.ScrollBarImageColor3 = Color3.fromRGB(80, 85, 100)
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)

        local PageList = Instance.new("UIListLayout", Page)
        PageList.Padding = UDim.new(0, 6)
        PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 10)
        end)

        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.Text = "  " .. name
        TabBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
        TabBtn.TextColor3 = Color3.fromRGB(150, 155, 165)
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 11
        TabBtn.TextXAlignment = 0
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        local BtnStroke = Instance.new("UIStroke", TabBtn)
        BtnStroke.Color = Color3.fromRGB(40, 44, 54)
        BtnStroke.Thickness = 1

        TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(Window.Pages) do
                p.Visible = false
            end
            for _, btn in pairs(Window.TabButtons) do
                TweenService:Create(btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(28, 31, 38),
                    TextColor3 = Color3.fromRGB(150, 155, 165)
                }):Play()
            end
            Page.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(35, 40, 50),
                TextColor3 = Color3.fromRGB(0, 212, 255)
            }):Play()
        end)

        if #Window.TabButtons == 0 then
            Page.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
            TabBtn.TextColor3 = Color3.fromRGB(0, 212, 255)
        end

        table.insert(Window.Pages, Page)
        table.insert(Window.TabButtons, TabBtn)

        local Tab = {}

        function Tab:AddSwitch(labelText, default, callback)
            local SwitchFrame = Instance.new("Frame", Page)
            SwitchFrame.Size = UDim2.new(1, 0, 0, 38)
            SwitchFrame.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", SwitchFrame)
            Label.Size = UDim2.new(0.6, 0, 1, 0)
            Label.Text = tostring(labelText or "Switch")
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0

            local BG = Instance.new("Frame", SwitchFrame)
            BG.Size = UDim2.new(0, 38, 0, 20)
            BG.Position = UDim2.new(1, -45, 0.5, -10)
            BG.BackgroundColor3 = default and Color3.fromRGB(0, 168, 204) or Color3.fromRGB(45, 48, 56)
            Instance.new("UICorner", BG).CornerRadius = UDim.new(1, 0)

            local Ball = Instance.new("Frame", BG)
            Ball.Size = UDim2.new(0, 14, 0, 14)
            Ball.Position = default and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            Ball.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)

            local ClickBtn = Instance.new("TextButton", SwitchFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            local state = default and true or false
            ClickBtn.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(Ball, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                    Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                }):Play()
                TweenService:Create(BG, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                    BackgroundColor3 = state and Color3.fromRGB(0, 168, 204) or Color3.fromRGB(45, 48, 56)
                }):Play()
                if callback then callback(state) end
            end)
        end

        function Tab:AddTextBox(labelText, placeholder, callback)
            local BoxFrame = Instance.new("Frame", Page)
            BoxFrame.Size = UDim2.new(1, 0, 0, 38)
            BoxFrame.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", BoxFrame)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Text = tostring(labelText or "Input")
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0

            local Input = Instance.new("TextBox", BoxFrame)
            Input.Size = UDim2.new(0, 65, 0, 26)
            Input.Position = UDim2.new(1, -70, 0.5, -13)
            Input.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            Input.TextColor3 = Color3.fromRGB(0, 212, 255)
            Input.Text = tostring(placeholder or "")
            Input.TextSize = 12
            Input.Font = Enum.Font.GothamBold
            Input.ClearTextOnFocus = true
            Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 6)
            local BoxStroke = Instance.new("UIStroke", Input)
            BoxStroke.Color = Color3.fromRGB(54, 59, 72)
            BoxStroke.Thickness = 1

            Input.FocusLost:Connect(function()
                if callback then callback(Input.Text) end
            end)
        end

        function Tab:AddButton(labelText, buttonText, callback)
            local ButtonFrame = Instance.new("Frame", Page)
            ButtonFrame.Size = UDim2.new(1, 0, 0, 38)
            ButtonFrame.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", ButtonFrame)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Text = tostring(labelText or "Action")
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0

            local ActionBtn = Instance.new("TextButton", ButtonFrame)
            ActionBtn.Size = UDim2.new(0, 100, 0, 28)
            ActionBtn.Position = UDim2.new(1, -105, 0.5, -14)
            ActionBtn.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            ActionBtn.TextColor3 = Color3.fromRGB(0, 212, 255)
            ActionBtn.Text = tostring(buttonText or "Click")
            ActionBtn.TextSize = 12
            ActionBtn.Font = Enum.Font.GothamBold
            Instance.new("UICorner", ActionBtn).CornerRadius = UDim.new(0, 6)
            local BtnStroke = Instance.new("UIStroke", ActionBtn)
            BtnStroke.Color = Color3.fromRGB(54, 59, 72)
            BtnStroke.Thickness = 1

            ActionBtn.MouseButton1Click:Connect(function()
                TweenService:Create(ActionBtn, TweenInfo.new(0.08), {
                    BackgroundColor3 = Color3.fromRGB(0, 168, 204),
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
                task.wait(0.08)
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {
                    BackgroundColor3 = Color3.fromRGB(33, 36, 43),
                    TextColor3 = Color3.fromRGB(0, 212, 255)
                }):Play()
                if callback then callback() end
            end)
        end

        function Tab:AddDropdown(labelText, options, callback)
            if type(options) ~= "table" then options = {} end

            local DropdownFrame = Instance.new("Frame", Page)
            DropdownFrame.Size = UDim2.new(1, 0, 0, 38)
            DropdownFrame.BackgroundTransparency = 1
            DropdownFrame.ClipsDescendants = false

            local Label = Instance.new("TextLabel", DropdownFrame)
            Label.Size = UDim2.new(0.4, 0, 1, 0)
            Label.Text = tostring(labelText or "Select")
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0

            local MainBtn = Instance.new("TextButton", DropdownFrame)
            MainBtn.Size = UDim2.new(0, 130, 0, 28)
            MainBtn.Position = UDim2.new(1, -135, 0.5, -14)
            MainBtn.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            MainBtn.TextColor3 = Color3.fromRGB(0, 212, 255)
            MainBtn.Text = tostring(options[1] or "None")
            MainBtn.Font = Enum.Font.GothamBold
            MainBtn.TextSize = 12
            Instance.new("UICorner", MainBtn).CornerRadius = UDim.new(0, 6)
            local DropStroke = Instance.new("UIStroke", MainBtn)
            DropStroke.Color = Color3.fromRGB(54, 59, 72)
            DropStroke.Thickness = 1

            local ScrollList = Instance.new("ScrollingFrame", MainBtn)
            ScrollList.Size = UDim2.new(1, 0, 0, 100)
            ScrollList.Position = UDim2.new(0, 0, 1, 5)
            ScrollList.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
            ScrollList.Visible = false
            ScrollList.ZIndex = 10
            ScrollList.ScrollBarThickness = 3
            ScrollList.CanvasSize = UDim2.new(0, 0, 0, 0)
            Instance.new("UICorner", ScrollList).CornerRadius = UDim.new(0, 6)
            local ListStroke = Instance.new("UIStroke", ScrollList)
            ListStroke.Color = Color3.fromRGB(0, 212, 255)
            ListStroke.Thickness = 1

            local ListLayout = Instance.new("UIListLayout", ScrollList)
            ListLayout.Padding = UDim.new(0, 2)
            ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 5)
            end)

            local isOpen = false
            MainBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                ScrollList.Visible = isOpen
            end)

            for _, optionName in pairs(options) do
                local OptBtn = Instance.new("TextButton", ScrollList)
                OptBtn.Size = UDim2.new(1, 0, 0, 25)
                OptBtn.BackgroundTransparency = 1
                OptBtn.Text = tostring(optionName)
                OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                OptBtn.Font = Enum.Font.GothamMedium
                OptBtn.TextSize = 11
                OptBtn.ZIndex = 11

                OptBtn.MouseButton1Click:Connect(function()
                    MainBtn.Text = tostring(optionName)
                    isOpen = false
                    ScrollList.Visible = false
                    if callback then callback(optionName) end
                end)
            end
        end

        -- [MỚI] Thanh kéo chỉnh thông số
        function Tab:AddSlider(labelText, minValue, maxValue, defaultValue, callback, decimals)
            minValue = tonumber(minValue) or 0
            maxValue = tonumber(maxValue) or 100
            if maxValue <= minValue then maxValue = minValue + 1 end
            decimals = math.clamp(math.floor(tonumber(decimals) or 0), 0, 10)
            defaultValue = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)

            local SliderFrame = Instance.new("Frame", Page)
            SliderFrame.Size = UDim2.new(1, 0, 0, 46)
            SliderFrame.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", SliderFrame)
            Label.Size = UDim2.new(0.7, 0, 0, 20)
            Label.Position = UDim2.new(0, 0, 0, 0)
            Label.Text = tostring(labelText or "Slider")
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0

            local ValueLabel = Instance.new("TextLabel", SliderFrame)
            ValueLabel.Size = UDim2.new(0, 70, 0, 20)
            ValueLabel.Position = UDim2.new(1, -70, 0, 0)
            ValueLabel.Text = string.format("%." .. decimals .. "f", defaultValue)
            ValueLabel.TextColor3 = Color3.fromRGB(0, 212, 255)
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextSize = 13
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.TextXAlignment = 1

            local Track = Instance.new("Frame", SliderFrame)
            Track.Size = UDim2.new(1, 0, 0, 6)
            Track.Position = UDim2.new(0, 0, 0, 30)
            Track.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
            Track.BorderSizePixel = 0
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local initAlpha = (defaultValue - minValue) / (maxValue - minValue)

            local Fill = Instance.new("Frame", Track)
            Fill.Size = UDim2.new(initAlpha, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 168, 204)
            Fill.BorderSizePixel = 0
            Fill.ZIndex = 2
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local Ball = Instance.new("Frame", Track)
            Ball.Size = UDim2.new(0, 14, 0, 14)
            Ball.Position = UDim2.new(initAlpha, -7, 0.5, -7)
            Ball.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Ball.ZIndex = 3
            Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)
            local BallStroke = Instance.new("UIStroke", Ball)
            BallStroke.Color = Color3.fromRGB(0, 212, 255)
            BallStroke.Thickness = 1.5

            -- Vùng bắt chuột/touch phủ cả thanh
            local HitArea = Instance.new("TextButton", SliderFrame)
            HitArea.Size = UDim2.new(1, 0, 0, 24)
            HitArea.Position = UDim2.new(0, 0, 0, 20)
            HitArea.BackgroundTransparency = 1
            HitArea.Text = ""
            HitArea.ZIndex = 5

            local currentValue = defaultValue
            local isDragging = false

            local function ApplyValue(v, fireCallback)
                currentValue = math.clamp(v, minValue, maxValue)
                local alpha = (currentValue - minValue) / (maxValue - minValue)
                Fill.Size = UDim2.new(alpha, 0, 1, 0)
                Ball.Position = UDim2.new(alpha, -7, 0.5, -7)
                ValueLabel.Text = string.format("%." .. decimals .. "f", currentValue)
                if fireCallback and callback then
                    callback(currentValue)
                end
            end

            local function UpdateFromInput(input)
                if not Track or not Track.Parent then return end
                if Track.AbsoluteSize.X <= 0 then return end
                local relX = input.Position.X - Track.AbsolutePosition.X
                local alpha = math.clamp(relX / Track.AbsoluteSize.X, 0, 1)
                ApplyValue(minValue + alpha * (maxValue - minValue), true)
            end

            HitArea.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    UpdateFromInput(input)
                end
            end)

            local changedConn = UserInputService.InputChanged:Connect(function(input)
                if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end)

            local endedConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = false
                end
            end)

            -- Tự dọn connection khi Page/ScreenGui bị destroy
            SliderFrame.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    if changedConn then changedConn:Disconnect() end
                    if endedConn then endedConn:Disconnect() end
                end
            end)

            local Slider = {}
            function Slider:Set(v)
                ApplyValue(v, true)
            end
            function Slider:Get()
                return currentValue
            end
            return Slider
        end

        function Tab:GetPageContainer()
            return Page
        end

        return Tab
    end

    return Window
end

return Library
