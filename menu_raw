    AccentBar.Position = UDim2.new(0, 4, 0, 4)
    AccentBar.BackgroundColor3 = Accent
    AccentBar.BackgroundTransparency = 1
    AccentBar.BorderSizePixel = 0
    AccentBar.ZIndex = 3
    Instance.new("UICorner", AccentBar).CornerRadius = UDim.new(1, 0)

    local TitleLbl = Instance.new("TextLabel", Notif)
    TitleLbl.Size = UDim2.new(1, -18, 0, 16)
    TitleLbl.Position = UDim2.new(0, 13, 0, 3)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = Title
    TitleLbl.TextColor3 = Accent
    TitleLbl.TextTransparency = 1
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 12
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.ZIndex = 3

    local ContentLbl = Instance.new("TextLabel", Notif)
    ContentLbl.Size = UDim2.new(1, -18, 0, contentHeight)
    ContentLbl.Position = UDim2.new(0, 13, 0, 20)
    ContentLbl.BackgroundTransparency = 1
    ContentLbl.Text = Content
    ContentLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    ContentLbl.TextTransparency = 1
    ContentLbl.Font = Enum.Font.GothamMedium
    ContentLbl.TextSize = 11
    ContentLbl.TextXAlignment = Enum.TextXAlignment.Left
    ContentLbl.TextYAlignment = Enum.TextYAlignment.Top
    ContentLbl.TextWrapped = true
    ContentLbl.ZIndex = 3

    local BarTrack = Instance.new("Frame", Notif)
    BarTrack.Size = UDim2.new(1, -20, 0, 3)
    BarTrack.Position = UDim2.new(0, 10, 1, -7)
    BarTrack.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
    BarTrack.BackgroundTransparency = 1
    BarTrack.BorderSizePixel = 0
    BarTrack.ZIndex = 3
    Instance.new("UICorner", BarTrack).CornerRadius = UDim.new(1, 0)

    local BarFill = Instance.new("Frame", BarTrack)
    BarFill.Size = UDim2.new(1, 0, 1, 0)
    BarFill.BackgroundColor3 = Accent
    BarFill.BackgroundTransparency = 1
    BarFill.BorderSizePixel = 0
    BarFill.ZIndex = 4
    Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1, 0)

    local slideIn  = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local fadeIn   = TweenInfo.new(0.4,  Enum.EasingStyle.Quad,  Enum.EasingDirection.Out)
    local growInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    TweenSvc:Create(Holder, growInfo, {Size = UDim2.new(1, 0, 0, totalHeight)}):Play()

    task.delay(0.08, function()
        if not Notif or not Notif.Parent then return end
        TweenSvc:Create(Notif,       slideIn, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        TweenSvc:Create(Notif,       fadeIn,  {BackgroundTransparency = 0}):Play()
        TweenSvc:Create(Stroke,      fadeIn,  {Transparency = 0.35}):Play()
        TweenSvc:Create(AccentBar,   fadeIn,  {BackgroundTransparency = 0}):Play()
        TweenSvc:Create(TitleLbl,    fadeIn,  {TextTransparency = 0}):Play()
        TweenSvc:Create(ContentLbl,  fadeIn,  {TextTransparency = 0}):Play()
        TweenSvc:Create(BarTrack,    fadeIn,  {BackgroundTransparency = 0.3}):Play()
        TweenSvc:Create(BarFill,     fadeIn,  {BackgroundTransparency = 0}):Play()
    end)

    task.delay(0.55, function()
        if not Notif or not Notif.Parent then return end
        TweenSvc:Create(BarFill, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0)
        }):Play()
    end)

    task.delay(0.55 + Duration, function()
        if not Notif or not Notif.Parent then return end

        local outInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        local outFade = TweenInfo.new(0.3, Enum.EasingStyle.Quad,  Enum.EasingDirection.In)

        TweenSvc:Create(Notif,       outInfo, {Position = UDim2.new(1, 380, 0, 0)}):Play()
        TweenSvc:Create(Notif,       outFade, {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(Stroke,      outFade, {Transparency = 1}):Play()
        TweenSvc:Create(AccentBar,   outFade, {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(TitleLbl,    outFade, {TextTransparency = 1}):Play()
        TweenSvc:Create(ContentLbl,  outFade, {TextTransparency = 1}):Play()
        TweenSvc:Create(BarTrack,    outFade, {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(BarFill,     outFade, {BackgroundTransparency = 1}):Play()

        task.wait(0.35)
        if not Holder or not Holder.Parent then return end
        local collapse = TweenSvc:Create(Holder, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, 0)
        })
        collapse:Play()
        collapse.Completed:Wait()
        if Holder and Holder.Parent then Holder:Destroy() end
    end)

    return Notif
end

