            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""
            ClickBtn.ZIndex = 5

            local state = default or false
            ClickBtn.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(Ball, TweenInfo.new(0.2), {
                    Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                }):Play()
                TweenService:Create(BG, TweenInfo.new(0.2), {
                    BackgroundColor3 = state and Color3.fromRGB(0, 168, 204) or Color3.fromRGB(45, 48, 56)
                }):Play()
                if callback then callback(state) end
            end)
        end

        function Tab:AddTextBox(labelText, placeholder, callback)
            local BoxFrame = Instance.new("Frame", Page)
            BoxFrame.Size = UDim2.new(1, 0, 0, 38)
            BoxFrame.BackgroundTransparency = 1
            BoxFrame.ZIndex = 4

            local Label = Instance.new("TextLabel", BoxFrame)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Text = labelText
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0
            Label.ZIndex = 4

            local Input = Instance.new("TextBox", BoxFrame)
            Input.Size = UDim2.new(0, 65, 0, 26)
            Input.Position = UDim2.new(1, -70, 0.5, -13)
            Input.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            Input.TextColor3 = Color3.fromRGB(0, 212, 255)
            Input.Text = placeholder or ""
            Input.TextSize = 12
            Input.Font = Enum.Font.GothamBold
            Input.ClearTextOnFocus = true
            Input.ZIndex = 5
            Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 6)
            local BoxStroke = Instance.new("UIStroke", Input)
            BoxStroke.Color = Color3.fromRGB(54, 59, 72)
            BoxStroke.Thickness = 1

            Input.FocusLost:Connect(function()
                if callback then callback(Input.Text) end
            end)
        end

        function Tab:AddButton(labelText, buttonText, callback)
            local ButtonFrame = Instance.new("Frame", Page)
            ButtonFrame.Size = UDim2.new(1, 0, 0, 38)
            ButtonFrame.BackgroundTransparency = 1
            ButtonFrame.ZIndex = 4

            local Label = Instance.new("TextLabel", ButtonFrame)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Text = labelText
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0
            Label.ZIndex = 4

            local ActionBtn = Instance.new("TextButton", ButtonFrame)
            ActionBtn.Size = UDim2.new(0, 100, 0, 28)
            ActionBtn.Position = UDim2.new(1, -105, 0.5, -14)
            ActionBtn.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            ActionBtn.TextColor3 = Color3.fromRGB(0, 212, 255)
            ActionBtn.Text = buttonText or "Click"
            ActionBtn.TextSize = 12
            ActionBtn.Font = Enum.Font.GothamBold
            ActionBtn.ZIndex = 5
            Instance.new("UICorner", ActionBtn).CornerRadius = UDim.new(0, 6)
            local BtnStroke = Instance.new("UIStroke", ActionBtn)
            BtnStroke.Color = Color3.fromRGB(54, 59, 72)
            BtnStroke.Thickness = 1

            ActionBtn.MouseButton1Click:Connect(function()
                TweenService:Create(ActionBtn, TweenInfo.new(0.08), {
                    BackgroundColor3 = Color3.fromRGB(0, 168, 204),
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
                task.wait(0.08)
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {
                    BackgroundColor3 = Color3.fromRGB(33, 36, 43),
                    TextColor3 = Color3.fromRGB(0, 212, 255)
                }):Play()
                if callback then callback() end
            end)
        end

        function Tab:AddDropdown(labelText, options, callback)
            local DropdownFrame = Instance.new("Frame", Page)
            DropdownFrame.Size = UDim2.new(1, 0, 0, 38)
            DropdownFrame.BackgroundTransparency = 1
            DropdownFrame.ClipsDescendants = false
            DropdownFrame.ZIndex = 10

            local Label = Instance.new("TextLabel", DropdownFrame)
            Label.Size = UDim2.new(0.4, 0, 1, 0)
            Label.Text = labelText
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = 0
            Label.ZIndex = 10

            local MainBtn = Instance.new("TextButton", DropdownFrame)
            MainBtn.Size = UDim2.new(0, 130, 0, 28)
            MainBtn.Position = UDim2.new(1, -135, 0.5, -14)
            MainBtn.BackgroundColor3 = Color3.fromRGB(33, 36, 43)
            MainBtn.TextColor3 = Color3.fromRGB(0, 212, 255)
            MainBtn.Text = options[1] or "None"
            MainBtn.Font = Enum.Font.GothamBold
            MainBtn.TextSize = 12
            MainBtn.ZIndex = 10
            Instance.new("UICorner", MainBtn).CornerRadius = UDim.new(0, 6)
            local DropStroke = Instance.new("UIStroke", MainBtn)
            DropStroke.Color = Color3.fromRGB(54, 59, 72)
            DropStroke.Thickness = 1

            local ScrollList = Instance.new("ScrollingFrame", MainBtn)
            ScrollList.Size = UDim2.new(1, 0, 0, 100)
            ScrollList.Position = UDim2.new(0, 0, 1, 5)
            ScrollList.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
            ScrollList.Visible = false
            ScrollList.ZIndex = 20
            ScrollList.ScrollBarThickness = 3
            ScrollList.CanvasSize = UDim2.new(0, 0, 0, 0)
            Instance.new("UICorner", ScrollList).CornerRadius = UDim.new(0, 6)
            local ListStroke = Instance.new("UIStroke", ScrollList)
            ListStroke.Color = Color3.fromRGB(0, 212, 255)
            ListStroke.Thickness = 1

            local ListLayout = Instance.new("UIListLayout", ScrollList)
            ListLayout.Padding = UDim.new(0, 2)
            ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 5)
            end)

            local isOpen = false
            MainBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                ScrollList.Visible = isOpen
            end)

            for _, optionName in pairs(options) do
                local OptBtn = Instance.new("TextButton", ScrollList)
                OptBtn.Size = UDim2.new(1, 0, 0, 25)
                OptBtn.BackgroundTransparency = 1
                OptBtn.Text = optionName
                OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                OptBtn.Font = Enum.Font.GothamMedium
                OptBtn.TextSize = 11
                OptBtn.ZIndex = 21

                OptBtn.MouseButton1Click:Connect(function()
                    MainBtn.Text = optionName
                    isOpen = false
                    ScrollList.Visible = false
                    if callback then callback(optionName) end
                end)
            end
        end

        function Tab:GetPageContainer()
            return Page
        end

        return Tab
    end

    return Window
end

return Library
