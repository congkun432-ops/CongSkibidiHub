        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = CENTER_POS
        MainFrame.BackgroundTransparency = 1
        MainFrame.ClipsDescendants = true

        if isMinimized then
            isMinimized = false
            MinimizeBtn.Text = "–"
            TabContainer.Visible = true
            ContentContainer.Visible = true
