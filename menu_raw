        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 50
    }, DropLayer)

    local openDropdownClose = nil
    local function CloseOpenDropdown()
        if openDropdownClose then
            local fn = openDropdownClose
            openDropdownClose = nil
            fn()
        end
    end

    DropBlocker.MouseButton1Click:Connect(CloseOpenDropdown)

    local isVisible   = false
    local isMinimized = false
    local menuToken   = 0

    local function SetPanelsVisible(v)
        TabContainer.Visible = v
        ContentContainer.Visible = v
    end

    local function OpenMenu()
        if isVisible or destroyed then return end
        isVisible = true
        isMinimized = false
        menuToken = menuToken + 1

        CloseOpenDropdown()
        MinimizeBtn.Text = "–"
        SetPanelsVisible(true)

        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = CenterOf(menuPos)
        MainFrame.BackgroundTransparency = 1

        Tween(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = FULL_SIZE,
            Position = menuPos
        })
        Tween(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0
        })
    end

    local function CloseMenu()
        if not isVisible then return end
        isVisible = false
        isMinimized = false
        menuToken = menuToken + 1
        local token = menuToken

        CloseOpenDropdown()
        MinimizeBtn.Text = "–"

        Tween(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Position = CenterOf(menuPos)
        })

        task.delay(0.3, function()
            if menuToken == token and MainFrame and MainFrame.Parent then
                MainFrame.Visible = false
            end
        end)
    end

    local function ToggleMenu()
        if isVisible then CloseMenu() else OpenMenu() end
    end

    local function MinimizeMenu()
        if not isVisible then return end
        isMinimized = not isMinimized
        menuToken = menuToken + 1
        local token = menuToken

        CloseOpenDropdown()

        if isMinimized then
            SetPanelsVisible(false)
            MinimizeBtn.Text = "+"
            Tween(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = MINI_SIZE })
        else
            MinimizeBtn.Text = "–"
            Tween(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = FULL_SIZE })
            task.delay(0.15, function()
                if menuToken == token and isVisible and not isMinimized then
                    SetPanelsVisible(true)
                end
            end)
        end
    end

    local function AttachDrag(handle, target, onClick, onDragEnd)
        local dragging    = false
        local moved       = false
        local dragInput   = nil
        local startPoint  = nil
        local startOffset = nil

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging    = true
                moved       = false
                dragInput   = input
                startPoint  = input.Position
                startOffset = target.Position
            end
        end)

        Track(UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then
                local delta = input.Position - startPoint
                if not moved and delta.Magnitude > 6 then moved = true end
                if moved then
                    target.Position = UDim2.new(
                        startOffset.X.Scale, startOffset.X.Offset + delta.X,
                        startOffset.Y.Scale, startOffset.Y.Offset + delta.Y
                    )
                end
            end
        end))

        Track(UserInputService.InputEnded:Connect(function(input)
            if not dragging then return end
            local sameInput = input == dragInput
                or (input.UserInputType == Enum.UserInputType.MouseButton1
                    and dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
            if sameInput then
                dragging = false
                if moved then
                    if onDragEnd then onDragEnd() end
                elseif onClick then
                    onClick()
                end
            end
        end))
    end

    AttachDrag(MobileToggle, MobileToggle, ToggleMenu, function()
        ClampToScreen(MobileToggle, ScreenGui)
    end)

    AttachDrag(TitleBar, MainFrame, nil, function()
        ClampToScreen(MainFrame, ScreenGui)
        menuPos = MainFrame.Position
    end)

    CloseBtn.MouseButton1Click:Connect(CloseMenu)
    MinimizeBtn.MouseButton1Click:Connect(MinimizeMenu)

    if ToggleKey then
        Track(UserInputService.InputBegan:Connect(function(input, processed)
            if processed or UserInputService:GetFocusedTextBox() then return end
            if input.KeyCode == ToggleKey then
                ToggleMenu()
            end
        end))
    end

