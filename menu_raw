    local function AttachDrag(handle, target, onClick, onDragEnd)
        local dragging    = false
        local moved       = false
        local dragInput   = nil
        local startPoint  = nil
        local startOffset = nil

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging    = true
                moved       = false
                dragInput   = input
                startPoint  = input.Position
                startOffset = target.Position
            end
        end)

        Track(UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then
                local delta = input.Position - startPoint
                if not moved and delta.Magnitude > 6 then moved = true end
                if moved then
                    target.Position = UDim2.new(
                        startOffset.X.Scale, startOffset.X.Offset + delta.X,
                        startOffset.Y.Scale, startOffset.Y.Offset + delta.Y
                    )
                end
            end
        end))

        Track(UserInputService.InputEnded:Connect(function(input)
            if not dragging then return end
            local sameInput = input == dragInput
                or (input.UserInputType == Enum.UserInputType.MouseButton1
                    and dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
            if sameInput then
                dragging = false
                if moved then
                    if onDragEnd then onDragEnd() end
                elseif onClick then
                    onClick()
                end
            end
        end))
    end

