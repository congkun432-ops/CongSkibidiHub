local function New(class, props, parent)
    local inst = Instance.new(class)
    props = props or {}
    for k, v in pairs(props) do
        inst[k] = v
    end
    if props.BorderSizePixel == nil and inst:IsA("GuiObject") then
        inst.BorderSizePixel = 0
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(parent, radius)
    return New("UICorner", { CornerRadius = radius }, parent)
end

local function Stroke(parent, color, thickness, transparency)
    return New("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
end

local function Tween(inst, info, props)
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

local function SafeCall(cb, ...)
    if type(cb) ~= "function" then return end
    local ok, err = pcall(cb, ...)
    if not ok then warn("[CyberVibe] " .. tostring(err)) end
end

local function GetGuiRoot()
    local okHui, hui = pcall(function()
        if type(gethui) == "function" then return gethui() end
        return nil
    end)
    if okHui and hui then return hui end
    local okCg, cg = pcall(function() return game:GetService("CoreGui") end)
    if okCg and cg then return cg end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function ParentGui(gui)
    local ok = pcall(function() gui.Parent = GetGuiRoot() end)
    if not ok or not gui.Parent then
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function GetViewport()
    local cam = workspace.CurrentCamera
    if cam then
        local s = cam.ViewportSize
        if s.X > 0 and s.Y > 0 then return s end
    end
    return Vector2.new(800, 600)
end

local function ClampToScreen(target, gui)
    local guiSize = gui.AbsoluteSize
    if guiSize.X <= 0 or guiSize.Y <= 0 then return end
    local pos  = target.Position
    local size = target.AbsoluteSize
    local px = pos.X.Scale * guiSize.X + pos.X.Offset
    local py = pos.Y.Scale * guiSize.Y + pos.Y.Offset
    local keep = 40
    local cx = math.clamp(px, keep - size.X, guiSize.X - keep)
    local cy = math.clamp(py, 0, guiSize.Y - keep)
    target.Position = UDim2.new(
        pos.X.Scale, math.floor(pos.X.Offset + (cx - px)),
        pos.Y.Scale, math.floor(pos.Y.Offset + (cy - py))
    )
end

local function NormalizeSoundId(id)
    if type(id) == "number" then
        return "rbxassetid://" .. tostring(id)
    end
    if type(id) == "string" and id ~= "" then
        if id:match("^%d+$") then
            return "rbxassetid://" .. id
        end
        return id
    end
    return nil
end

local function PlayNotifySound(customId)
    task.spawn(function()
        local ids = {}
        local custom = NormalizeSoundId(customId)
        if custom then table.insert(ids, custom) end
        for _, id in ipairs(DEFAULT_SOUNDS) do
            if id ~= custom then table.insert(ids, id) end
        end

        for _, id in ipairs(ids) do
            local snd = Instance.new("Sound")
            snd.Name = "CyberVibe_NotifySound"
            snd.SoundId = id
            snd.Volume = 0.6
            snd.Looped = false
            snd.Parent = SoundService

            pcall(function() ContentProvider:PreloadAsync({ snd }) end)

            local waited = 0
            while not snd.IsLoaded and waited < 2 do
                task.wait(0.05)
                waited = waited + 0.05
            end

            if snd.IsLoaded and snd.TimeLength > 0 then
                snd:Play()
                task.delay(snd.TimeLength + 1, function()
                    if snd and snd.Parent then snd:Destroy() end
                end)
                return
            end

            snd:Destroy()
        end
    end)
end

