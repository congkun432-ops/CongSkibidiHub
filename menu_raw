            BG.Size = UDim2.new(0, 38, 0, 20)
            BG.Position = UDim2.new(1, -45, 0.5, -10)
            BG.BackgroundColor3 = default and Color3.fromRGB(0, 168, 204) or Color3.fromRGB(45, 48, 56)
            BG.ZIndex = 4
            Instance.new("UICorner", BG).CornerRadius = UDim.new(1, 0)

            local Ball = Instance.new("Frame", BG)
            Ball.Size = UDim2.new(0, 14, 0, 14)
            Ball.Position = default and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            Ball.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Ball.ZIndex = 5
            Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)

