    function Window:SaveConfig(name)
        if not HasFileSystem() then
            return false, "Executor không hỗ trợ writefile"
        end
        local data = {}
        for flag, obj in pairs(Window.Flags) do
            local ok, value = pcall(function() return obj:Get() end)
            if ok and value ~= nil then data[flag] = value end
        end
        local okEnc, encoded = pcall(function() return HttpService:JSONEncode(data) end)
        if not okEnc then return false, "Không thể mã hóa cấu hình" end

        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("CyberVibe") then
            pcall(makefolder, "CyberVibe")
        end
        local okWrite, err = pcall(writefile, ConfigPath(name), encoded)
        if not okWrite then return false, tostring(err) end
        return true
    end

    function Window:LoadConfig(name)
        if not HasFileSystem() then
            return false, "Executor không hỗ trợ readfile"
        end
        local path = ConfigPath(name)
        if type(isfile) == "function" and not isfile(path) then
            return false, "Không tìm thấy file cấu hình"
        end
        local okRead, raw = pcall(readfile, path)
        if not okRead then return false, tostring(raw) end
        local okDec, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not okDec or type(data) ~= "table" then
            return false, "File cấu hình bị lỗi"
        end
        for flag, value in pairs(data) do
            local obj = Window.Flags[flag]
            if obj and obj.Set then pcall(obj.Set, obj, value) end
        end
        return true
    end

