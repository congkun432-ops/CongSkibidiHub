function Library:LoadIntro(source)
    local ok, fn = pcall(function()
        local code
        if type(isfile) == "function" and type(readfile) == "function" and isfile(source) then
            code = readfile(source)
        else
            code = game:HttpGet(source)
        end
        return loadstring(code)()
    end)
    if ok and type(fn) == "function" then
        IntroPlayer = fn
        return true
    end
    warn("[CyberVibe] Không nạp được intro: " .. tostring(fn))
    return false
end

local function PlayIntro(title, subtitle)
    if not IntroPlayer then return end
    local ok, err = pcall(IntroPlayer, {
        New = New, Corner = Corner, Stroke = Stroke, Tween = Tween,
        ParentGui = ParentGui, GetViewport = GetViewport,
        Colors = {
            ACCENT = ACCENT, BG_CONTROL = BG_CONTROL, BG_OFF = BG_OFF,
            TEXT_MAIN = TEXT_MAIN, TEXT_DIM = TEXT_DIM, WHITE = WHITE,
        },
        Title = title, Subtitle = subtitle,
        Steps = { L("intro_s1"), L("intro_s2"), L("intro_s3"), L("intro_s4"), L("intro_s5"), L("intro_s6") },
    })
    if not ok then warn("[CyberVibe] Intro: " .. tostring(err)) end
end

function Library:Notify(config)
    if type(config) ~= "table" then
        config = { Content = tostring(config or "") }
    end

    local typeKey  = config.Type or config.type
    local typeInfo = typeKey and NOTIFY_TYPES[string.lower(tostring(typeKey))] or nil

    local Title    = config.Title or config.title or (typeInfo and L(typeInfo.TitleKey)) or L("n_info")
    local Content  = config.Content or config.content or config.Message or config.message or ""
    local Duration = config.Duration or config.duration or 4
    local Accent   = config.Color or config.color or (typeInfo and typeInfo.Color) or ACCENT
    local Silent   = config.Silent or config.silent or false
    local SoundId  = config.SoundId or config.soundId

    if type(Duration) ~= "number" or Duration <= 0 then Duration = 4 end
    Content = tostring(Content)

    local gui       = EnsureNotifyGui()
    local Container = gui:FindFirstChild("Container")
    if not Container then return nil end

    if not Silent then
        local now = tick()
        if now - lastNotifySound > 0.25 then
            lastNotifySound = now
            PlayNotifySound(SoundId)
        end
    end

    notifySlot = notifySlot + 1

    local TEXT_X = 36
    local TEXT_W = NOTIF_W - TEXT_X - 10
    local contentHeight = 0
    if #Content > 0 then
        local ok, bounds = pcall(function()
            return TextService:GetTextSize(Content, 10, Enum.Font.GothamMedium, Vector2.new(TEXT_W, 1000))
        end)
        contentHeight = (ok and bounds) and math.max(12, bounds.Y) or 12
    end
    local totalHeight = math.max(34, 19 + contentHeight + 11)

    local Holder = New("Frame", {
        Name = "Holder",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        LayoutOrder = notifySlot,
        ClipsDescendants = false
    }, Container)

    local Notif = New("Frame", {
        Name = "Notif",
        Size = UDim2.new(1, 0, 0, totalHeight),
        Position = UDim2.new(1, 260, 0, 0),
        BackgroundColor3 = BG_PANEL,
        BackgroundTransparency = 1,
        ZIndex = 2
    }, Holder)
    Corner(Notif, UDim.new(0, 9))

    local NotifStroke = Stroke(Notif, Accent, 1, 1)
    NotifStroke.ZIndex = 3

    local IconBadge = New("Frame", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 9, 0, 7),
        BackgroundColor3 = Accent,
        BackgroundTransparency = 1,
        ZIndex = 3
    }, Notif)
    Corner(IconBadge, UDim.new(1, 0))

    local IconLbl = New("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = typeInfo and typeInfo.Icon or "•",
        TextColor3 = Accent,
        TextTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        ZIndex = 4
    }, IconBadge)

    local TitleLbl = New("TextLabel", {
        Size = UDim2.new(1, -(TEXT_X + 8), 0, 14),
        Position = UDim2.new(0, TEXT_X, 0, 4),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = TEXT_MAIN,
        TextTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 3
    }, Notif)

    local ContentLbl = New("TextLabel", {
        Size = UDim2.new(1, -(TEXT_X + 8), 0, contentHeight),
        Position = UDim2.new(0, TEXT_X, 0, 18),
        BackgroundTransparency = 1,
        Text = Content,
        TextColor3 = Color3.fromRGB(165, 170, 182),
        TextTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 3
    }, Notif)

    local BarTrack = New("Frame", {
        Size = UDim2.new(1, -20, 0, 2),
        Position = UDim2.new(0, 10, 1, -6),
        BackgroundColor3 = BG_OFF,
        BackgroundTransparency = 1,
        ZIndex = 3
    }, Notif)
    Corner(BarTrack, UDim.new(1, 0))

    local BarFill = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Accent,
        BackgroundTransparency = 1,
        ZIndex = 4
    }, BarTrack)
    Corner(BarFill, UDim.new(1, 0))

    local slideIn  = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local fadeIn   = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local growInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    local dismissed = false

    local function Dismiss()
        if dismissed then return end
        dismissed = true

        for i, fn in ipairs(activeNotifs) do
            if fn == Dismiss then
                table.remove(activeNotifs, i)
                break
            end
        end

        task.spawn(function()
            if not Notif or not Notif.Parent then return end

            local outInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            local outFade = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            Tween(Notif, outInfo, { Position = UDim2.new(1, 260, 0, 0) })
            Tween(Notif, outFade, { BackgroundTransparency = 1 })
            Tween(NotifStroke, outFade, { Transparency = 1 })
            Tween(IconBadge, outFade, { BackgroundTransparency = 1 })
            Tween(IconLbl, outFade, { TextTransparency = 1 })
            Tween(TitleLbl, outFade, { TextTransparency = 1 })
            Tween(ContentLbl, outFade, { TextTransparency = 1 })
            Tween(BarTrack, outFade, { BackgroundTransparency = 1 })
            Tween(BarFill, outFade, { BackgroundTransparency = 1 })

            task.wait(0.3)
            if not Holder or not Holder.Parent then return end

            local collapse = Tween(Holder, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 0)
            })
            collapse.Completed:Wait()
            if Holder and Holder.Parent then Holder:Destroy() end
        end)
    end

    table.insert(activeNotifs, Dismiss)
    while #activeNotifs > MAX_NOTIFS do
        local oldest = table.remove(activeNotifs, 1)
        if oldest then oldest() end
    end

    Tween(Holder, growInfo, { Size = UDim2.new(1, 0, 0, totalHeight) })

    task.delay(0.08, function()
        if dismissed or not Notif or not Notif.Parent then return end
        Tween(Notif, slideIn, { Position = UDim2.new(0, 0, 0, 0) })
        Tween(Notif, fadeIn, { BackgroundTransparency = 0.02 })
        Tween(NotifStroke, fadeIn, { Transparency = 0.55 })
        Tween(IconBadge, fadeIn, { BackgroundTransparency = 0.8 })
        Tween(IconLbl, fadeIn, { TextTransparency = 0 })
        Tween(TitleLbl, fadeIn, { TextTransparency = 0 })
        Tween(ContentLbl, fadeIn, { TextTransparency = 0 })
        Tween(BarTrack, fadeIn, { BackgroundTransparency = 0.4 })
        Tween(BarFill, fadeIn, { BackgroundTransparency = 0 })
    end)

    task.delay(0.55, function()
        if dismissed or not BarFill or not BarFill.Parent then return end
        Tween(BarFill, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0)
        })
    end)

    task.delay(0.55 + Duration, Dismiss)

    return Notif
end

