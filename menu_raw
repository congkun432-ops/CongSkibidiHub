-- [[ CYBERVIBE UI LIBRARY MODULE - v2 ]]
local Library = {}

--------------------------------------------------------------------
-- CORE HELPERS
--------------------------------------------------------------------
local windowSlot = 0
local notifySlot = 0
local NotifyGui = nil

local function GetCoreGui()
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

--------------------------------------------------------------------
-- CUSTOM NOTIFICATION SYSTEM
--------------------------------------------------------------------
local function EnsureNotifyGui()
    local CoreGui = GetCoreGui()
    if NotifyGui and NotifyGui.Parent then return NotifyGui end

    NotifyGui = Instance.new("ScreenGui")
    NotifyGui.Name = "CyberVibe_Notifications_" .. math.random(10000, 99999)
    NotifyGui.ResetOnSpawn = false
    NotifyGui.DisplayOrder = 999999
    NotifyGui.IgnoreGuiInset = true
    NotifyGui.Parent = CoreGui

    local Container = Instance.new("Frame", NotifyGui)
    Container.Name = "Container"
    Container.Size = UDim2.new(0, 290, 0, 0)
    Container.Position = UDim2.new(1, -305, 0, 50)
    Container.BackgroundTransparency = 1

    local Layout = Instance.new("UIListLayout", Container)
    Layout.Padding = UDim.new(0, 6)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

    return NotifyGui
end

function Library:Notify(config)
    config = config or {}
    local Title    = config.Title    or config.title    or "Thông Báo"
    local Content  = config.Content  or config.content  or config.Message or config.message or ""
    local Duration = config.Duration or config.duration or 4
    local Accent   = config.Color    or config.color    or Color3.fromRGB(0, 212, 255)

    local gui       = EnsureNotifyGui()
    local Container = gui:FindFirstChild("Container")
    local TweenSvc  = game:GetService("TweenService")
    local TextSvc   = game:GetService("TextService")

    notifySlot = notifySlot + 1

    -- Đo chiều cao nội dung
    local contentHeight = 16
    if Content and #Content > 0 then
        local ok, bounds = pcall(function()
            return TextSvc:GetTextSize(Content, 12, Enum.Font.GothamMedium, Vector2.new(250, 1000))
        end)
        if ok and bounds then
            contentHeight = math.max(16, bounds.Y)
        end
    end
    local totalHeight = math.max(60, 30 + contentHeight + 12)

    -- Frame chính
    local Notif = Instance.new("Frame")
    Notif.Size = UDim2.new(1, 0, 0, 0)
    Notif.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
    Notif.BorderSizePixel = 0
    Notif.LayoutOrder = notifySlot
    Notif.ZIndex = 2
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 8)

    local Stroke = Instance.new("UIStroke", Notif)
    Stroke.Color = Accent
    Stroke.Thickness = 1.5
    Stroke.Transparency = 0.3
    Stroke.ZIndex = 3

    -- Thanh accent bên trái
    local AccentBar = Instance.new("Frame", Notif)
    AccentBar.Size = UDim2.new(0, 4, 1, -10)
    AccentBar.Position = UDim2.new(0, 4, 0, 5)
    AccentBar.BackgroundColor3 = Accent
    AccentBar.BorderSizePixel = 0
    AccentBar.ZIndex = 3
    Instance.new("UICorner", AccentBar).CornerRadius = UDim.new(1, 0)

    -- Title
    local TitleLbl = Instance.new("TextLabel", Notif)
    TitleLbl.Size = UDim2.new(1, -35, 0, 20)
    TitleLbl.Position = UDim2.new(0, 16, 0, 6)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = Title
    TitleLbl.TextColor3 = Accent
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 13
    TitleLbl.TextXAlignment = 0
    TitleLbl.ZIndex = 3

    -- Content
    local ContentLbl = Instance.new("TextLabel", Notif)
    ContentLbl.Size = UDim2.new(1, -35, 0, contentHeight)
    ContentLbl.Position = UDim2.new(0, 16, 0, 26)
    ContentLbl.BackgroundTransparency = 1
    ContentLbl.Text = Content
    ContentLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    ContentLbl.Font = Enum.Font.GothamMedium
    ContentLbl.TextSize = 12
    ContentLbl.TextXAlignment = 0
    ContentLbl.TextYAlignment = 0
    ContentLbl.TextWrapped = true
    ContentLbl.ZIndex = 3

    -- Nút X
    local CloseX = Instance.new("TextButton", Notif)
    CloseX.Size = UDim2.new(0, 18, 0, 18)
    CloseX.Position = UDim2.new(1, -24, 0, 6)
    CloseX.BackgroundTransparency = 1
    CloseX.Text = "×"
    CloseX.TextColor3 = Color3.fromRGB(180, 180, 180)
    CloseX.Font = Enum.Font.GothamBold
    CloseX.TextSize = 16
    CloseX.AutoButtonColor = false
    CloseX.ZIndex = 4

    Notif.Parent = Container

    TweenSvc:Create(Notif, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0, totalHeight)
    }):Play()

    local dismissed = false
    local dismissThread = nil

    local function Dismiss()
        if dismissed then return end
        dismissed = true
        if dismissThread then
            task.cancel(dismissThread)
            dismissThread = nil
        end
        TweenSvc:Create(Notif, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        TweenSvc:Create(Stroke, TweenInfo.new(0.22), {Transparency = 1}):Play()
        TweenSvc:Create(AccentBar, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(TitleLbl, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
        TweenSvc:Create(ContentLbl, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
        TweenSvc:Create(CloseX, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
        task.wait(0.22)
        if Notif and Notif.Parent then Notif:Destroy() end
    end

    CloseX.MouseButton1Click:Connect(Dismiss)

    if Duration > 0 then
        dismissThread = task.delay(Duration, Dismiss)
    end

    return Notif
end

