local DEFAULT_SOUNDS = {
    "rbxassetid://876939830",
    "rbxassetid://6026984224",
    "rbxassetid://4590657391",
    "rbxassetid://9120386436"
}

local function NormalizeSoundId(id)
    if type(id) == "number" then
        return "rbxassetid://" .. tostring(id)
    end
    if type(id) == "string" and id ~= "" then
        if id:match("^%d+$") then
            return "rbxassetid://" .. id
        end
        return id
    end
    return nil
end

local function PlayNotifySound(customId)
    task.spawn(function()
        local SoundSvc = game:GetService("SoundService")
        local ContentSvc = game:GetService("ContentProvider")

        local ids = {}
        local custom = NormalizeSoundId(customId)
        if custom then table.insert(ids, custom) end
        for _, id in ipairs(DEFAULT_SOUNDS) do
            if id ~= custom then table.insert(ids, id) end
        end

        for _, id in ipairs(ids) do
            local snd = Instance.new("Sound")
            snd.Name = "CyberVibe_NotifySound"
            snd.SoundId = id
            snd.Volume = 0.6
            snd.Looped = false
            snd.Parent = SoundSvc

            pcall(function() ContentSvc:PreloadAsync({snd}) end)

            local waited = 0
            while not snd.IsLoaded and waited < 2 do
                task.wait(0.05)
                waited = waited + 0.05
            end

            if snd.IsLoaded and snd.TimeLength > 0 then
                snd:Play()
                task.delay(snd.TimeLength + 1, function()
                    if snd and snd.Parent then snd:Destroy() end
                end)
                return
            end

            snd:Destroy()
        end
    end)
end

function Library:Notify(config)
    config = config or {}
    local Title    = config.Title    or config.title    or "Thông Báo"
    local Content  = config.Content  or config.content  or config.Message or config.message or ""
    local Duration = config.Duration or config.duration or 4
    local Accent   = config.Color    or config.color    or Color3.fromRGB(0, 212, 255)
    local Silent   = config.Silent   or config.silent   or false
    local SoundId  = config.SoundId  or config.soundId

    if type(Duration) ~= "number" or Duration <= 0 then Duration = 4 end

    local gui       = EnsureNotifyGui()
    local Container = gui:FindFirstChild("Container")
    local TweenSvc  = game:GetService("TweenService")
    local TextSvc   = game:GetService("TextService")

    if not Silent then
        local now = tick()
        if now - lastNotifySound > 0.25 then
            lastNotifySound = now
            PlayNotifySound(SoundId)
        end
    end

    notifySlot = notifySlot + 1

    local TEXT_W = 310
    local contentHeight = 14
    if Content and #Content > 0 then
        local ok, bounds = pcall(function()
            return TextSvc:GetTextSize(Content, 11, Enum.Font.GothamMedium, Vector2.new(TEXT_W, 1000))
        end)
        if ok and bounds then
            contentHeight = math.max(14, bounds.Y)
        end
    end
    local totalHeight = math.max(48, 20 + contentHeight + 14)

    local Holder = Instance.new("Frame")
    Holder.Name = "Holder"
    Holder.Size = UDim2.new(1, 0, 0, 0)
    Holder.BackgroundTransparency = 1
    Holder.BorderSizePixel = 0
    Holder.LayoutOrder = notifySlot
    Holder.ClipsDescendants = false
    Holder.Parent = Container

    local Notif = Instance.new("Frame", Holder)
    Notif.Name = "Notif"
    Notif.Size = UDim2.new(1, 0, 0, totalHeight)
    Notif.Position = UDim2.new(1, 380, 0, 0)
    Notif.BackgroundColor3 = Color3.fromRGB(25, 27, 34)
    Notif.BackgroundTransparency = 1
    Notif.BorderSizePixel = 0
    Notif.ZIndex = 2
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 7)

    local Stroke = Instance.new("UIStroke", Notif)
    Stroke.Color = Accent
    Stroke.Thickness = 1.2
    Stroke.Transparency = 1
    Stroke.ZIndex = 3

    local AccentBar = Instance.new("Frame", Notif)
