        function Tab:AddSlider(labelText, minValue, maxValue, defaultValue, callback, decimals)
            minValue = tonumber(minValue) or 0
            maxValue = tonumber(maxValue) or 100
            if maxValue <= minValue then maxValue = minValue + 1 end
            decimals = math.max(0, math.floor(tonumber(decimals) or 0))
            local currentValue = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)

            local SliderFrame = Instance.new("Frame", Page)
            SliderFrame.Size = UDim2.new(1, 0, 0, 46)
            SliderFrame.BackgroundTransparency = 1
            SliderFrame.ZIndex = 4

            local Label = Instance.new("TextLabel", SliderFrame)
            Label.Size = UDim2.new(0.7, 0, 0, 16)
            Label.Position = UDim2.new(0, 0, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = labelText
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = 0
            Label.ZIndex = 4

            local ValueLabel = Instance.new("TextLabel", SliderFrame)
            ValueLabel.Size = UDim2.new(0, 80, 0, 16)
            ValueLabel.Position = UDim2.new(1, -80, 0, 0)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = string.format("%."..decimals.."f", currentValue)
            ValueLabel.TextColor3 = Color3.fromRGB(0, 212, 255)
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextSize = 12
            ValueLabel.TextXAlignment = 1
            ValueLabel.ZIndex = 4

            local BarBG = Instance.new("Frame", SliderFrame)
            BarBG.Size = UDim2.new(1, 0, 0, 6)
            BarBG.Position = UDim2.new(0, 0, 0, 28)
            BarBG.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
            BarBG.BorderSizePixel = 0
            BarBG.ZIndex = 4
            Instance.new("UICorner", BarBG).CornerRadius = UDim.new(1, 0)

            local initPct = (currentValue - minValue) / (maxValue - minValue)

            local Fill = Instance.new("Frame", BarBG)
            Fill.Size = UDim2.new(initPct, 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 168, 204)
            Fill.BorderSizePixel = 0
            Fill.ZIndex = 5
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local Knob = Instance.new("Frame", BarBG)
            Knob.Size = UDim2.new(0, 14, 0, 14)
            Knob.Position = UDim2.new(initPct, -7, 0.5, -7)
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Knob.BorderSizePixel = 0
            Knob.ZIndex = 6
            Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

            local InputBtn = Instance.new("TextButton", SliderFrame)
            InputBtn.Size = UDim2.new(1, 0, 0, 22)
            InputBtn.Position = UDim2.new(0, 0, 0, 20)
            InputBtn.BackgroundTransparency = 1
            InputBtn.Text = ""
            InputBtn.AutoButtonColor = false
            InputBtn.ZIndex = 7

            local dragging = false

            local function ApplyValue(v, animate)
                v = math.clamp(v, minValue, maxValue)
                if decimals == 0 then v = math.floor(v + 0.5) end
                currentValue = v
                ValueLabel.Text = string.format("%."..decimals.."f", v)
                local pct = (v - minValue) / (maxValue - minValue)
                if animate then
                    TweenService:Create(Fill, TweenInfo.new(0.05), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
                    TweenService:Create(Knob, TweenInfo.new(0.05), {Position = UDim2.new(pct, -7, 0.5, -7)}):Play()
                else
                    Fill.Size = UDim2.new(pct, 0, 1, 0)
                    Knob.Position = UDim2.new(pct, -7, 0.5, -7)
                end
                if callback then pcall(callback, v) end
            end

            local function UpdateFromX(x)
                local barAbs = BarBG.AbsolutePosition.X
                local barW = BarBG.AbsoluteSize.X
                if barW <= 0 then return end
                local pct = math.clamp((x - barAbs) / barW, 0, 1)
                ApplyValue(minValue + (maxValue - minValue) * pct, true)
            end

            InputBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateFromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    UpdateFromX(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local SliderObj = {}
            function SliderObj:Set(v)
                ApplyValue(tonumber(v) or minValue, false)
            end
            function SliderObj:Get()
                return currentValue
            end

            return SliderObj
        end

        function Tab:GetPageContainer()
            return Page
        end

        return Tab
    end

