        function Tab:AddDropdown(labelText, options, callback, flag)
            options = options or {}

            local Row = MakeRow(38, 10)
            MakeLabel(Row, labelText, 0.4, 10)

            local current = options[1]

            local MainBtn = New("TextButton", {
                Size = UDim2.new(0, 130, 0, 28),
                Position = UDim2.new(1, -135, 0.5, -14),
                BackgroundColor3 = BG_CONTROL,
                TextColor3 = ACCENT,
                Text = current ~= nil and tostring(current) or "None",
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AutoButtonColor = false,
                ZIndex = 10
            }, Row)
            Corner(MainBtn, UDim.new(0, 6))
            Stroke(MainBtn, STROKE_COL, 1)

            local ListFrame = New("ScrollingFrame", {
                Visible = false,
                BackgroundColor3 = BG_PANEL,
                ScrollBarThickness = 3,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollingDirection = Enum.ScrollingDirection.Y,
                Active = true,
                ZIndex = 51
            }, DropLayer)
            Corner(ListFrame, UDim.new(0, 6))
            Stroke(ListFrame, ACCENT, 1)
            New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, ListFrame)
            New("UIPadding", {
                PaddingTop = UDim.new(0, 3),
                PaddingBottom = UDim.new(0, 3),
                PaddingLeft = UDim.new(0, 3),
                PaddingRight = UDim.new(0, 3)
            }, ListFrame)

            local isOpen = false
            local optionButtons = {}

            local function RefreshColors()
                for _, entry in ipairs(optionButtons) do
                    local selected = tostring(entry.value) == tostring(current)
                    entry.btn.TextColor3 = selected and ACCENT or Color3.fromRGB(200, 200, 200)
                    entry.btn.BackgroundTransparency = selected and 0.85 or 1
                end
            end

            local function Close()
                isOpen = false
                ListFrame.Visible = false
                DropLayer.Visible = false
            end

            local function Select(value)
                current = value
                MainBtn.Text = tostring(value)
                RefreshColors()
                if isOpen then
                    if openDropdownClose == Close then openDropdownClose = nil end
                    Close()
                end
                SafeCall(callback, value)
            end

            local function Build()
                for _, entry in ipairs(optionButtons) do entry.btn:Destroy() end
                table.clear(optionButtons)

                for i, opt in ipairs(options) do
                    local OptBtn = New("TextButton", {
                        Size = UDim2.new(1, 0, 0, 25),
                        BackgroundColor3 = ACCENT,
                        BackgroundTransparency = 1,
                        Text = tostring(opt),
                        TextColor3 = Color3.fromRGB(200, 200, 200),
                        Font = Enum.Font.GothamMedium,
                        TextSize = 11,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        ZIndex = 52
                    }, ListFrame)
                    Corner(OptBtn, UDim.new(0, 4))
                    OptBtn.MouseButton1Click:Connect(function() Select(opt) end)
                    table.insert(optionButtons, { btn = OptBtn, value = opt })
                end
                RefreshColors()
            end

            local function Open()
                CloseOpenDropdown()

                local btnPos  = MainBtn.AbsolutePosition - MainFrame.AbsolutePosition
                local btnSize = MainBtn.AbsoluteSize
                local listH   = math.min(#options * 27 + 6, 130)
                if listH < 32 then listH = 32 end

                local y = btnPos.Y + btnSize.Y + 4
                if y + listH > MainFrame.AbsoluteSize.Y - 4 then
                    y = btnPos.Y - listH - 4
                end
                y = math.max(y, 4)

                ListFrame.Position = UDim2.new(0, btnPos.X, 0, y)
                ListFrame.Size = UDim2.new(0, btnSize.X, 0, listH)
                ListFrame.Visible = true
                DropLayer.Visible = true
                isOpen = true
                openDropdownClose = Close
            end

            MainBtn.MouseButton1Click:Connect(function()
                if isOpen then
                    CloseOpenDropdown()
                else
                    Open()
                end
            end)

            Build()

            local obj = {}
            function obj:Set(value)
                for _, opt in ipairs(options) do
                    if tostring(opt) == tostring(value) then
                        Select(opt)
                        return
                    end
                end
            end
            function obj:Get() return current end
            function obj:Refresh(newOptions, keepCurrent)
                CloseOpenDropdown()
                options = newOptions or {}
                local stillValid = false
                if keepCurrent then
                    for _, opt in ipairs(options) do
                        if tostring(opt) == tostring(current) then
                            stillValid = true
                            break
                        end
                    end
                end
                if not stillValid then
                    current = options[1]
                    MainBtn.Text = current ~= nil and tostring(current) or "None"
                end
                Build()
            end
            return Register(flag, obj)
        end

        function Tab:AddSlider(labelText, minValue, maxValue, defaultValue, callback, decimals, flag)
            minValue = tonumber(minValue) or 0
            maxValue = tonumber(maxValue) or 100
            if maxValue <= minValue then maxValue = minValue + 1 end
            decimals = math.max(0, math.floor(tonumber(decimals) or 0))
            local mult = 10 ^ decimals
            local fmt  = "%." .. decimals .. "f"

            local function Round(v)
                return math.floor(v * mult + 0.5) / mult
            end

            local currentValue = math.clamp(Round(tonumber(defaultValue) or minValue), minValue, maxValue)

            local Row = MakeRow(50)

            New("TextLabel", {
                Size = UDim2.new(1, -70, 0, 20),
                BackgroundTransparency = 1,
                Text = labelText,
                TextColor3 = TEXT_MAIN,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 4
            }, Row)

            local ValuePill = New("Frame", {
                AnchorPoint = Vector2.new(1, 0),
                Size = UDim2.new(0, 0, 0, 20),
                Position = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = BG_CONTROL,
                ZIndex = 4
            }, Row)
            Corner(ValuePill, UDim.new(0, 6))
            Stroke(ValuePill, STROKE_COL, 1)
            New("UISizeConstraint", { MinSize = Vector2.new(44, 20) }, ValuePill)
            New("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8)
            }, ValuePill)

            local ValueLabel = New("TextLabel", {
                Size = UDim2.new(0, 0, 1, 0),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text = string.format(fmt, currentValue),
                TextColor3 = ACCENT,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                ZIndex = 5
            }, ValuePill)

            local BarBG = New("Frame", {
                Size = UDim2.new(1, -16, 0, 6),
                Position = UDim2.new(0, 8, 0, 34),
                BackgroundColor3 = BG_OFF,
                ZIndex = 4
            }, Row)
            Corner(BarBG, UDim.new(1, 0))

            local initPct = (currentValue - minValue) / (maxValue - minValue)

            local Fill = New("Frame", {
                Size = UDim2.new(initPct, 0, 1, 0),
                BackgroundColor3 = WHITE,
                ZIndex = 5
            }, BarBG)
            Corner(Fill, UDim.new(1, 0))
            New("UIGradient", {
                Color = ColorSequence.new(ACCENT_DARK, ACCENT)
            }, Fill)

            local Knob = New("Frame", {
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new(initPct, -8, 0.5, -8),
                BackgroundColor3 = WHITE,
                ZIndex = 6
            }, BarBG)
            Corner(Knob, UDim.new(1, 0))
            local KnobStroke = Stroke(Knob, ACCENT, 2)

            local InputBtn = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                Position = UDim2.new(0, 0, 0, 22),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 7
            }, Row)

            local dragging    = false
            local activeInput = nil

            local function ApplyValue(v, animate)
                v = math.clamp(Round(v), minValue, maxValue)
                currentValue = v
                ValueLabel.Text = string.format(fmt, v)
                local pct = (v - minValue) / (maxValue - minValue)
                if animate then
                    Tween(Fill, TweenInfo.new(0.05), { Size = UDim2.new(pct, 0, 1, 0) })
                    Tween(Knob, TweenInfo.new(0.05), { Position = UDim2.new(pct, -8, 0.5, -8) })
                else
                    Fill.Size = UDim2.new(pct, 0, 1, 0)
                    Knob.Position = UDim2.new(pct, -8, 0.5, -8)
                end
                SafeCall(callback, v)
            end

            local function UpdateFromX(x)
                local barAbs = BarBG.AbsolutePosition.X
                local barW   = BarBG.AbsoluteSize.X
                if barW <= 0 then return end
                local pct = math.clamp((x - barAbs) / barW, 0, 1)
                ApplyValue(minValue + (maxValue - minValue) * pct, true)
            end

            local function StopDrag()
                if not dragging then return end
                dragging = false
                activeInput = nil
                Page.ScrollingEnabled = true
                Tween(Knob, TweenInfo.new(0.12), { Size = UDim2.new(0, 16, 0, 16) })
                KnobStroke.Thickness = 2
            end

            InputBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    activeInput = input
                    Page.ScrollingEnabled = false
                    KnobStroke.Thickness = 3
                    UpdateFromX(input.Position.X)
                end
            end)

            Track(UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement or input == activeInput then
                    UpdateFromX(input.Position.X)
                end
            end))

            Track(UserInputService.InputEnded:Connect(function(input)
                if not dragging then return end
                if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    StopDrag()
                end
            end))

            local obj = {}
            function obj:Set(v)
                ApplyValue(tonumber(v) or minValue, false)
            end
            function obj:Get()
                return currentValue
            end
            return Register(flag, obj)
        end

        function Tab:GetPageContainer()
            return Page
        end

        return Tab
    end

