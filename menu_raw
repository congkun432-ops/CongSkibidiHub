            TweenService:Create(MainFrame, TweenInfo.new(0.3), { Size = MINI_SIZE }):Play()
            MinimizeBtn.Text = "+"
            TabContainer.Visible = false
            ContentContainer.Visible = false
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.3), { Size = FULL_SIZE }):Play()
            MinimizeBtn.Text = "–"
            task.wait(0.3)
            TabContainer.Visible = true
            ContentContainer.Visible = true
            MainFrame.ClipsDescendants = false
