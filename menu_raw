                        Close()
                    end
                    SafeCall(callback, value)
                end

                local function Build()
                    for _, entry in ipairs(optionButtons) do entry.btn:Destroy() end
                    table.clear(optionButtons)

                    for i, opt in ipairs(options) do
                        local OptBtn = New("TextButton", {
                            Size = UDim2.new(1, 0, 0, 25),
                            BackgroundColor3 = ACCENT,
                            BackgroundTransparency = 1,
                            Text = tostring(opt),
                            TextColor3 = Color3.fromRGB(200, 200, 200),
                            Font = Enum.Font.GothamMedium,
                            TextSize = 11,
                            TextTruncate = Enum.TextTruncate.AtEnd,
                            AutoButtonColor = false,
                            LayoutOrder = i,
                            ZIndex = 52
                        }, ListFrame)
                        Corner(OptBtn, UDim.new(0, 4))
                        OptBtn.MouseButton1Click:Connect(function() Select(opt) end)
                        table.insert(optionButtons, { btn = OptBtn, value = opt })
                    end
                    RefreshColors()
                end

                local function Open()
                    CloseOpenDropdown()

                    local btnPos  = MainBtn.AbsolutePosition - MainFrame.AbsolutePosition
                    local btnSize = MainBtn.AbsoluteSize
                    local listH   = math.min(#options * 27 + 6, 130)
                    if listH < 32 then listH = 32 end

                    local y = btnPos.Y + btnSize.Y + 4
                    if y + listH > MainFrame.AbsoluteSize.Y - 4 then
                        y = btnPos.Y - listH - 4
                    end
                    y = math.max(y, 4)

                    ListFrame.Position = UDim2.new(0, btnPos.X, 0, y)
                    ListFrame.Size = UDim2.new(0, btnSize.X, 0, listH)
                    ListFrame.Visible = true
                    DropLayer.Visible = true
                    isOpen = true
                    openDropdownClose = Close
                end

                MainBtn.MouseButton1Click:Connect(function()
                    if isOpen then
                        CloseOpenDropdown()
                    else
                        Open()
                    end
                end)

                Build()

                local obj = {}
                function obj:Set(value)
                    for _, opt in ipairs(options) do
                        if tostring(opt) == tostring(value) then
                            Select(opt)
                            return
                        end
                    end
                end
                function obj:Get() return current end
                function obj:Refresh(newOptions, keepCurrent)
                    CloseOpenDropdown()
                    options = newOptions or {}
                    local stillValid = false
                    if keepCurrent then
                        for _, opt in ipairs(options) do
                            if tostring(opt) == tostring(current) then
                                stillValid = true
                                break
                            end
                        end
                    end
                    if not stillValid then
                        current = options[1]
                        MainBtn.Text = current ~= nil and tostring(current) or "None"
                    end
                    Build()
                end
                return Register(flag, obj)
            end

            function Api:AddSlider(labelText, minValue, maxValue, defaultValue, callback, decimals, flag)
                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                if maxValue <= minValue then maxValue = minValue + 1 end
                decimals = math.max(0, math.floor(tonumber(decimals) or 0))
                local mult = 10 ^ decimals
                local fmt  = "%." .. decimals .. "f"

                local function Round(v)
                    return math.floor(v * mult + 0.5) / mult
                end

                local currentValue = math.clamp(Round(tonumber(defaultValue) or minValue), minValue, maxValue)

                local Row = MakeRow(50)

                New("TextLabel", {
                    Size = UDim2.new(1, -70, 0, 20),
                    BackgroundTransparency = 1,
                    Text = labelText,
                    TextColor3 = TEXT_MAIN,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 4
                }, Row)

                local ValuePill = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0),
                    Size = UDim2.new(0, 0, 0, 20),
                    Position = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundColor3 = BG_CONTROL,
                    ZIndex = 4
                }, Row)
                Corner(ValuePill, UDim.new(0, 6))
                Stroke(ValuePill, STROKE_COL, 1)
                New("UISizeConstraint", { MinSize = Vector2.new(44, 20) }, ValuePill)
                New("UIPadding", {
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8)
                }, ValuePill)

                local ValueLabel = New("TextLabel", {
                    Size = UDim2.new(0, 0, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text = string.format(fmt, currentValue),
                    TextColor3 = ACCENT,
                    Font = Enum.Font.GothamBold,
                    TextSize = 11,
                    ZIndex = 5
                }, ValuePill)

                local BarBG = New("Frame", {
                    Size = UDim2.new(1, -16, 0, 6),
                    Position = UDim2.new(0, 8, 0, 34),
                    BackgroundColor3 = BG_OFF,
                    ZIndex = 4
                }, Row)
                Corner(BarBG, UDim.new(1, 0))

                local initPct = (currentValue - minValue) / (maxValue - minValue)

                local Fill = New("Frame", {
                    Size = UDim2.new(initPct, 0, 1, 0),
                    BackgroundColor3 = WHITE,
                    ZIndex = 5
                }, BarBG)
                Corner(Fill, UDim.new(1, 0))
                New("UIGradient", {
                    Color = ColorSequence.new(ACCENT_DARK, ACCENT)
                }, Fill)

                local Knob = New("Frame", {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = UDim2.new(initPct, -8, 0.5, -8),
                    BackgroundColor3 = WHITE,
                    ZIndex = 6
                }, BarBG)
                Corner(Knob, UDim.new(1, 0))
                local KnobStroke = Stroke(Knob, ACCENT, 2)

                local InputBtn = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 7
                }, Row)

                local dragging    = false
                local activeInput = nil

                local function ApplyValue(v, animate)
                    v = math.clamp(Round(v), minValue, maxValue)
                    currentValue = v
                    ValueLabel.Text = string.format(fmt, v)
                    local pct = (v - minValue) / (maxValue - minValue)
                    if animate then
                        Tween(Fill, TweenInfo.new(0.05), { Size = UDim2.new(pct, 0, 1, 0) })
                        Tween(Knob, TweenInfo.new(0.05), { Position = UDim2.new(pct, -8, 0.5, -8) })
                    else
                        Fill.Size = UDim2.new(pct, 0, 1, 0)
                        Knob.Position = UDim2.new(pct, -8, 0.5, -8)
                    end
                    SafeCall(callback, v)
                end

                local function UpdateFromX(x)
                    local barAbs = BarBG.AbsolutePosition.X
                    local barW   = BarBG.AbsoluteSize.X
                    if barW <= 0 then return end
                    local pct = math.clamp((x - barAbs) / barW, 0, 1)
                    ApplyValue(minValue + (maxValue - minValue) * pct, true)
                end

                local function StopDrag()
                    if not dragging then return end
                    dragging = false
                    activeInput = nil
                    Page.ScrollingEnabled = true
                    Tween(Knob, TweenInfo.new(0.12), { Size = UDim2.new(0, 16, 0, 16) })
                    KnobStroke.Thickness = 2
                end

                InputBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        activeInput = input
                        Page.ScrollingEnabled = false
                        KnobStroke.Thickness = 3
                        UpdateFromX(input.Position.X)
                    end
                end)

                Track(UserInputService.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if input.UserInputType == Enum.UserInputType.MouseMovement or input == activeInput then
                        UpdateFromX(input.Position.X)
                    end
                end))

                Track(UserInputService.InputEnded:Connect(function(input)
                    if not dragging then return end
                    if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
                        StopDrag()
                    end
                end))

                local obj = {}
                function obj:Set(v)
                    ApplyValue(tonumber(v) or minValue, false)
                end
                function obj:Get()
                    return currentValue
                end
                return Register(flag, obj)
            end

            ------------------------------------------------------------
            -- SECTION (tab con xổ xuống / thu lại)
            ------------------------------------------------------------
            function Api:AddSection(title, defaultOpen, callback, flag)
                title = tostring(title or "Section")
                local isOpen      = defaultOpen and true or false
                local PAD_V       = 6
                local HEADER_H    = 34
                local RIGHT_RESERVE = 68      -- chỗ dành cho badge + nút mũi tên bên phải
                local heightTween = nil
                local visToken    = 0
                local hovering    = false

                local COL_HOVER = Color3.fromRGB(42, 48, 61)
                local COL_PRESS = Color3.fromRGB(24, 27, 34)

                local Holder = MakeRow(0)
                Holder.Name = "Section"
                Holder.AutomaticSize = Enum.AutomaticSize.Y
                New("UIListLayout", {
                    Padding = UDim.new(0, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder
                }, Holder)

                ------------------------------------------------------------
                -- THANH TIÊU ĐỀ
                ------------------------------------------------------------
                local Header = New("TextButton", {
                    Name = "Header",
                    Size = UDim2.new(1, 0, 0, HEADER_H),
                    BackgroundColor3 = isOpen and BG_TAB_ON or BG_TAB,
                    Text = "",
                    AutoButtonColor = false,
                    LayoutOrder = 1,
                    ZIndex = 4
                }, Holder)
                Corner(Header, UDim.new(0, 8))
                local HeaderStroke = Stroke(Header, isOpen and ACCENT or STROKE_COL, 1, isOpen and 0.45 or 0)
                New("UIGradient", {
                    Color = ColorSequence.new(WHITE, Color3.fromRGB(205, 210, 222)),
                    Rotation = 90
                }, Header)

                -- Thanh nhấn bên trái (dài ra + sáng lên khi mở)
                local Bar = New("Frame", {
                    Name = "AccentBar",
                    AnchorPoint = Vector2.new(0, 0.5),
                    Size = UDim2.new(0, 3, 0, isOpen and 16 or 8),
                    Position = UDim2.new(0, 8, 0.5, 0),
                    BackgroundColor3 = isOpen and ACCENT or STROKE_COL,
                    ZIndex = 5
                }, Header)
                Corner(Bar, UDim.new(1, 0))

                local TitleLbl = New("TextLabel", {
                    Position = UDim2.new(0, 20, 0, 0),
                    Size = UDim2.new(0, 80, 1, 0),
                    BackgroundTransparency = 1,
                    Text = title,
                    TextColor3 = isOpen and ACCENT or TEXT_MAIN,
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 5
                }, Header)

                local Line = New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Size = UDim2.new(1, -120, 0, 1),
                    Position = UDim2.new(0, 100, 0.5, 0),
                    BackgroundColor3 = STROKE_COL,
                    BackgroundTransparency = 0.35,
                    ZIndex = 5
                }, Header)

                -- Huy hiệu hiển thị số chức năng bên trong
                local Badge = New("Frame", {
                    Name = "Badge",
                    AnchorPoint = Vector2.new(1, 0.5),
                    Size = UDim2.new(0, 24, 0, 18),
                    Position = UDim2.new(1, -36, 0.5, 0),
                    BackgroundColor3 = BG_CONTROL,
                    ZIndex = 5
                }, Header)
                Corner(Badge, UDim.new(1, 0))
                local BadgeLbl = New("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "0",
                    TextColor3 = isOpen and ACCENT or TEXT_DIM,
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    ZIndex = 6
                }, Badge)

                -- Nút mũi tên dạng chip bo tròn
                local Chip = New("Frame", {
                    Name = "Chip",
                    AnchorPoint = Vector2.new(1, 0.5),
                    Size = UDim2.new(0, 22, 0, 22),
                    Position = UDim2.new(1, -8, 0.5, 0),
                    BackgroundColor3 = isOpen and ACCENT or BG_CONTROL,
                    ZIndex = 5
                }, Header)
                Corner(Chip, UDim.new(0, 7))
                local Arrow = New("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    TextColor3 = isOpen and BG_MAIN or ACCENT,
                    Font = Enum.Font.GothamBold,
                    TextSize = 9,
                    Rotation = isOpen and 0 or -90,
                    ZIndex = 6
                }, Chip)

                local function LayoutHeader()
                    local ok, b = pcall(function()
                        return TextService:GetTextSize(title, 13, Enum.Font.GothamBold, Vector2.new(1000, 40))
                    end)
                    local w = math.min((ok and b and b.X) or 80, 150)
                    TitleLbl.Text = title
                    TitleLbl.Size = UDim2.new(0, w + 2, 1, 0)
                    Line.Position = UDim2.new(0, 20 + w + 10, 0.5, 0)
                    Line.Size = UDim2.new(1, -(20 + w + 10 + RIGHT_RESERVE), 0, 1)
                end
                LayoutHeader()

                ------------------------------------------------------------
                -- THÂN SECTION (có đường dẫn thụt lề bên trái)
                ------------------------------------------------------------
                local Wrap = New("Frame", {
                    Name = "Body",
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = BG_PANEL,
                    BackgroundTransparency = 0.35,
                    ClipsDescendants = true,
                    Visible = isOpen,
                    LayoutOrder = 2,
                    ZIndex = 4
                }, Holder)
                Corner(Wrap, UDim.new(0, 8))

                local Guide = New("Frame", {
                    Name = "Guide",
                    Position = UDim2.new(0, 9, 0, PAD_V),
                    Size = UDim2.new(0, 2, 1, -PAD_V * 2),
                    BackgroundColor3 = ACCENT,
                    BackgroundTransparency = 0.6,
                    ZIndex = 4
                }, Wrap)
                Corner(Guide, UDim.new(1, 0))

                -- Body = nơi chứa control (GetContainer trả về Frame này)
                local Body = New("Frame", {
                    Name = "Content",
                    Position = UDim2.new(0, 17, 0, 0),
                    Size = UDim2.new(1, -23, 1, 0),
                    BackgroundTransparency = 1,
                    ZIndex = 4
                }, Wrap)
                New("UIPadding", {
                    PaddingTop = UDim.new(0, PAD_V),
                    PaddingBottom = UDim.new(0, PAD_V)
                }, Body)
                local ContentLayout = New("UIListLayout", {
                    Padding = UDim.new(0, 6),
                    SortOrder = Enum.SortOrder.LayoutOrder
                }, Body)

                -- Cập nhật số chức năng trên huy hiệu
                local function RefreshBadge()
                    local n = 0
                    for _, c in ipairs(Body:GetChildren()) do
                        if c:IsA("GuiObject") then n = n + 1 end
                    end
                    BadgeLbl.Text = tostring(n)
                    Badge.Visible = n > 0
                end
                Body.ChildAdded:Connect(function() task.defer(RefreshBadge) end)
                Body.ChildRemoved:Connect(function() task.defer(RefreshBadge) end)
                RefreshBadge()

                local function TargetHeight()
                    local h = ContentLayout.AbsoluteContentSize.Y
                    if h <= 0 then return 0 end
                    return h + PAD_V * 2
                end

                local animInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                local fastInfo = TweenInfo.new(0.2)

                local function BaseColor()
                    return isOpen and BG_TAB_ON or BG_TAB
                end

                local function Apply(v, animate)
                    isOpen = v and true or false
                    CloseOpenDropdown()

                    visToken = visToken + 1
                    local token = visToken
                    if heightTween then
                        heightTween:Cancel()
                        heightTween = nil
                    end

                    -- Chiều cao thân
                    if isOpen then
                        Wrap.Visible = true
                        if animate then
                            heightTween = Tween(Wrap, animInfo, { Size = UDim2.new(1, 0, 0, TargetHeight()) })
                        else
                            Wrap.Size = UDim2.new(1, 0, 0, TargetHeight())
                        end
                    else
                        if animate then
                            heightTween = Tween(Wrap, animInfo, { Size = UDim2.new(1, 0, 0, 0) })
                            task.delay(0.27, function()
                                if visToken == token and not isOpen and Wrap and Wrap.Parent then
                                    Wrap.Visible = false
                                end
                            end)
                        else
                            Wrap.Size = UDim2.new(1, 0, 0, 0)
                            Wrap.Visible = false
                        end
                    end

                    -- Màu sắc / hiệu ứng thanh tiêu đề
                    local arrowRot = isOpen and 0 or -90
                    local hdrColor = hovering and COL_HOVER or BaseColor()
                    if animate then
                        Tween(Arrow, animInfo, { Rotation = arrowRot, TextColor3 = isOpen and BG_MAIN or ACCENT })
                        Tween(Chip, fastInfo, { BackgroundColor3 = isOpen and ACCENT or BG_CONTROL })
                        Tween(TitleLbl, fastInfo, { TextColor3 = isOpen and ACCENT or TEXT_MAIN })
                        Tween(BadgeLbl, fastInfo, { TextColor3 = isOpen and ACCENT or TEXT_DIM })
                        Tween(Bar, animInfo, {
                            Size = UDim2.new(0, 3, 0, isOpen and 16 or 8),
                            BackgroundColor3 = isOpen and ACCENT or STROKE_COL
                        })
                        Tween(HeaderStroke, fastInfo, {
                            Color = isOpen and ACCENT or STROKE_COL,
                            Transparency = isOpen and 0.45 or 0
                        })
                        Tween(Header, fastInfo, { BackgroundColor3 = hdrColor })
                    else
                        Arrow.Rotation = arrowRot
                        Arrow.TextColor3 = isOpen and BG_MAIN or ACCENT
                        Chip.BackgroundColor3 = isOpen and ACCENT or BG_CONTROL
                        TitleLbl.TextColor3 = isOpen and ACCENT or TEXT_MAIN
                        BadgeLbl.TextColor3 = isOpen and ACCENT or TEXT_DIM
                        Bar.Size = UDim2.new(0, 3, 0, isOpen and 16 or 8)
                        Bar.BackgroundColor3 = isOpen and ACCENT or STROKE_COL
                        HeaderStroke.Color = isOpen and ACCENT or STROKE_COL
                        HeaderStroke.Transparency = isOpen and 0.45 or 0
                        Header.BackgroundColor3 = hdrColor
                    end
                end

                -- Nội dung thay đổi (thêm control / section con đang xổ) -> cập nhật chiều cao
                ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    if isOpen then
                        if heightTween then
                            heightTween:Cancel()
                            heightTween = nil
                        end
                        Wrap.Size = UDim2.new(1, 0, 0, TargetHeight())
                    end
                end)

                Header.MouseEnter:Connect(function()
                    hovering = true
                    Tween(Header, TweenInfo.new(0.15), { BackgroundColor3 = COL_HOVER })
                end)
                Header.MouseLeave:Connect(function()
                    hovering = false
                    Tween(Header, TweenInfo.new(0.15), { BackgroundColor3 = BaseColor() })
                end)
                Header.MouseButton1Down:Connect(function()
                    Tween(Header, TweenInfo.new(0.08), { BackgroundColor3 = COL_PRESS })
                end)
                Header.MouseButton1Up:Connect(function()
                    Tween(Header, TweenInfo.new(0.12), { BackgroundColor3 = hovering and COL_HOVER or BaseColor() })
                end)

                Header.MouseButton1Click:Connect(function()
                    Apply(not isOpen, true)
                    SafeCall(callback, isOpen)
                end)

                -- Section có đầy đủ AddSwitch / AddSlider / AddButton / AddDropdown / AddTextBox / AddSection
                local Section = BuildControls(Body)

                local function SetState(v)
                    v = v and true or false
                    if v == isOpen then return end
                    Apply(v, true)
                    SafeCall(callback, isOpen)
                end

                function Section:Open()   SetState(true)  end
                function Section:Close()  SetState(false) end
                function Section:Toggle() SetState(not isOpen) end
                function Section:IsOpen() return isOpen end
                function Section:Get()    return isOpen end
                function Section:Set(v)   SetState(v) end
                function Section:SetTitle(t)
                    title = tostring(t)
                    LayoutHeader()
                end
                function Section:GetContainer() return Body end

                return Register(flag, Section)
            end

            Api.AddSubTab = Api.AddSection

            return Api
        end

        local Tab = BuildControls(Page)

        function Tab:GetPageContainer()
            return Page
        end

        return Tab
    end

    return Window
end

return Library
