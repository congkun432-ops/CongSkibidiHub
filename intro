--[[
    CyberVibe_Intro.luau  —  Animation mở đầu (module riêng)

    Cách dùng (trong script chính):
        local Library = loadstring(...)()           -- thư viện CyberVibe
        Library:SetIntro(loadstring(readfile("CyberVibe_Intro.luau"))())
        -- hoặc: Library:LoadIntro("CyberVibe_Intro.luau")  /  Library:LoadIntro("https://.../CyberVibe_Intro.luau")

    Module trả về 1 hàm nhận `ctx` (do thư viện truyền vào) và CHẠY ĐẾN KHI INTRO KẾT THÚC.
    Chỉnh nhanh ở khối CONFIG bên dưới.
]]

return function(ctx)
    local New, Corner, Stroke, Tween = ctx.New, ctx.Corner, ctx.Stroke, ctx.Tween
    local Col = ctx.Colors
    local ACCENT, WHITE, TEXT_MAIN, TEXT_DIM = Col.ACCENT, Col.WHITE, Col.TEXT_MAIN, Col.TEXT_DIM
    local BG_CONTROL, BG_OFF = Col.BG_CONTROL, Col.BG_OFF

    local RunService  = game:GetService("RunService")
    local TextService = game:GetService("TextService")
    local Lighting    = game:GetService("Lighting")
    local TweenService = game:GetService("TweenService")

    -- ===================== CONFIG =====================
    local PURPLE     = Color3.fromRGB(150, 90, 255)
    local EYE_GAP    = 50      -- khoảng cách 2 chữ C so với tâm
    local EYE_Y      = 56      -- độ cao con mắt
    local LOGO_Y     = 60
    local BAR_TIME   = 2.8     -- thời gian thanh tiến trình
    local BLUR_SIZE  = 18      -- độ mờ nền game (0 = tắt)
    local PARTICLES  = 18      -- số hạt sáng bay vào tâm (0 = tắt)
    local TITLE      = ctx.Title or "COURIER CAT"
    local SUBTITLE   = ctx.Subtitle
    local SKIP_TEXT  = ctx.SkipText or "Tap to skip"
    -- ==================================================

    local Q, S, B, QD = Enum.EasingStyle.Quint, Enum.EasingStyle.Sine, Enum.EasingStyle.Back, Enum.EasingStyle.Quad
    local OUT, IN, INOUT = Enum.EasingDirection.Out, Enum.EasingDirection.In, Enum.EasingDirection.InOut
    local function TI(t, style, dir)
        return TweenInfo.new(t, style or Q, dir or OUT)
    end

    local skipped = false
    local conns = {}
    local vp = ctx.GetViewport()
    local scale = math.clamp(math.min(vp.X, vp.Y) / 430, 0.6, 1.25)

    local gui = New("ScreenGui", {
        Name = "CyberVibe_Intro_" .. math.random(1000, 9999),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })
    ctx.ParentGui(gui)

    -- Làm mờ nền game (không bắt buộc)
    local blur
    if BLUR_SIZE > 0 then
        pcall(function()
            blur = Instance.new("BlurEffect")
            blur.Name = "CyberVibe_IntroBlur"
            blur.Size = 0
            blur.Parent = Lighting
        end)
    end

    local function Cleanup()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        if blur then pcall(function() blur:Destroy() end) end
        if gui and gui.Parent then gui:Destroy() end
    end

    local function Run()
        -- ===================== DỰNG GIAO DIỆN =====================
        local Dim = New("TextButton", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(6, 7, 11),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 1
        }, gui)
        Dim.Activated:Connect(function() skipped = true end)

        local Hint = New("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -26),
            Size = UDim2.new(0, 200, 0, 16),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Text = SKIP_TEXT,
            TextSize = 12,
            TextColor3 = TEXT_DIM,
            TextTransparency = 1,
            ZIndex = 2
        }, gui)

        local Root = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(0, 320, 0, 230),
            BackgroundTransparency = 1,
            ZIndex = 2
        }, gui)
        local RootScale = New("UIScale", { Scale = scale * 0.9 }, Root)

        local function Circle(size, color, transp, z)
            local f = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, EYE_Y),
                Size = UDim2.fromOffset(size, size),
                BackgroundColor3 = color,
                BackgroundTransparency = transp,
                ZIndex = z
            }, Root)
            Corner(f, UDim.new(1, 0))
            return f
        end

        -- Hào quang mềm phía sau (3 lớp chồng nhau)
        local glowTargets = {
            { Circle(0, ACCENT, 1, 2), 200, 0.95 },
            { Circle(0, ACCENT, 1, 2), 140, 0.90 },
            { Circle(0, PURPLE, 1, 2), 90,  0.86 },
        }

        -- Vòng quay (đuôi sao chổi) quanh con mắt
        local Ring = Circle(0, WHITE, 1, 3)
        Ring.BackgroundTransparency = 1
        local RingStroke = Stroke(Ring, WHITE, 2, 1)
        local RingGrad = New("UIGradient", {
            Color = ColorSequence.new(ACCENT, PURPLE),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.4, 0.65),
                NumberSequenceKeypoint.new(0.75, 1),
                NumberSequenceKeypoint.new(1, 1),
            })
        }, RingStroke)

        -- Sóng xung kích khi 2 chữ C ghép lại
        local Shock = Circle(20, WHITE, 1, 3)
        local ShockStroke = Stroke(Shock, ACCENT, 3, 1)

        local function MakeC(startX, rot)
            local lbl = New("TextLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, startX, 0, LOGO_Y),
                Size = UDim2.new(0, 100, 0, 120),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "C",
                TextSize = 100,
                TextColor3 = WHITE,
                TextTransparency = 1,
                Rotation = rot,
                ZIndex = 4
            }, Root)
            local grad = New("UIGradient", { Color = ColorSequence.new(ACCENT, PURPLE), Rotation = 45 }, lbl)
            local st = New("UIStroke", {
                Color = ACCENT, Thickness = 2, Transparency = 1,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
            }, lbl)
            return lbl, grad, st
        end
        local CL, GradL, StL = MakeC(-EYE_GAP - 150, 0)
        local CR, GradR, StR = MakeC(EYE_GAP + 150, 180)

        -- Con mắt
        local Iris = Circle(0, BG_CONTROL, 0, 5)
        Iris.ClipsDescendants = true
        local IrisStroke = Stroke(Iris, ACCENT, 2, 1)
        local Pupil = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = WHITE,
            ZIndex = 6
        }, Iris)
        Corner(Pupil, UDim.new(1, 0))
        local Spark = New("Frame", {
            Position = UDim2.fromOffset(3, 3),
            Size = UDim2.fromOffset(4, 4),
            BackgroundColor3 = ACCENT,
            ZIndex = 7
        }, Pupil)
        Corner(Spark, UDim.new(1, 0))

        -- Tiêu đề: từng chữ hiện lên lần lượt
        local TitleRow = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 142),
            Size = UDim2.new(0, 300, 0, 24),
            BackgroundTransparency = 1,
            ZIndex = 4
        }, Root)
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 5)
        }, TitleRow)

        local letters = {}
        local idx = 0
        for _, cp in utf8.codes(TITLE) do
            local ch = utf8.char(cp)
            idx = idx + 1
            local w = 10
            if ch ~= " " then
                local okW, size = pcall(function()
                    return TextService:GetTextSize(ch, 17, Enum.Font.GothamBold, Vector2.new(200, 50))
                end)
                w = okW and math.max(8, math.ceil(size.X)) or 12
            end
            local holder = New("Frame", {
                Size = UDim2.new(0, w, 1, 0),
                BackgroundTransparency = 1,
                LayoutOrder = idx,
                ZIndex = 4
            }, TitleRow)
            letters[#letters + 1] = New("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                Position = UDim2.fromOffset(0, 12),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = ch,
                TextSize = 17,
                TextColor3 = ACCENT,
                TextTransparency = 1,
                ZIndex = 4
            }, holder)
        end

        local Sub
        if SUBTITLE and SUBTITLE ~= "" then
            Sub = New("TextLabel", {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 168),
                Size = UDim2.new(0, 300, 0, 14),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = SUBTITLE,
                TextSize = 11,
                TextColor3 = TEXT_DIM,
                TextTransparency = 1,
                ZIndex = 4
            }, Root)
        end

        -- Thanh tiến trình + phần trăm
        local BarTrack = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 194),
            Size = UDim2.new(0, 150, 0, 3),
            BackgroundColor3 = BG_OFF,
            BackgroundTransparency = 1,
            ZIndex = 4
        }, Root)
        Corner(BarTrack, UDim.new(1, 0))
        local BarFill = New("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = ACCENT,
            BackgroundTransparency = 1,
            ZIndex = 5
        }, BarTrack)
        Corner(BarFill, UDim.new(1, 0))
        New("UIGradient", { Color = ColorSequence.new(ACCENT, PURPLE) }, BarFill)
        local BarTip = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(1, 0.5),
            Size = UDim2.fromOffset(7, 7),
            BackgroundColor3 = WHITE,
            BackgroundTransparency = 1,
            ZIndex = 6
        }, BarFill)
        Corner(BarTip, UDim.new(1, 0))
        local Pct = New("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 204),
            Size = UDim2.new(0, 100, 0, 14),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            Text = "0%",
            TextSize = 10,
            TextColor3 = TEXT_DIM,
            TextTransparency = 1,
            ZIndex = 4
        }, Root)

        table.insert(conns, RunService.Heartbeat:Connect(function()
            Pct.Text = string.format("%d%%", math.floor(BarFill.Size.X.Scale * 100 + 0.5))
        end))

        -- ===================== TIỆN ÍCH =====================
        local function Step(t)
            local e = 0
            while e < t and not skipped do
                e = e + task.wait()
            end
            return not skipped
        end

        local function SpawnParticles()
            for i = 1, PARTICLES do
                local a = (i / PARTICLES) * math.pi * 2 + math.random() * 0.4
                local r = math.random(150, 240)
                local sz = math.random(2, 4)
                local d = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, math.cos(a) * r, 0, EYE_Y + math.sin(a) * r * 0.6),
                    Size = UDim2.fromOffset(sz, sz),
                    BackgroundColor3 = (i % 2 == 0) and ACCENT or PURPLE,
                    BackgroundTransparency = 1,
                    ZIndex = 3
                }, Root)
                Corner(d, UDim.new(1, 0))
                task.delay(math.random() * 0.4, function()
                    if not d.Parent then return end
                    Tween(d, TI(0.25, S), { BackgroundTransparency = 0.15 })
                    Tween(d, TI(1.0, QD, IN), { Position = UDim2.new(0.5, 0, 0, EYE_Y) })
                    task.delay(0.75, function()
                        if d.Parent then Tween(d, TI(0.25, S), { BackgroundTransparency = 1 }) end
                    end)
                end)
            end
        end

        -- ===================== KỊCH BẢN =====================
        local function Intro()
            -- 1) Nền, mờ, thanh tiến trình, hạt sáng
            Tween(Dim, TI(0.5, S), { BackgroundTransparency = 0.25 })
            Tween(RootScale, TI(1.4), { Scale = scale })
            Tween(Hint, TI(0.9, S), { TextTransparency = 0.55 })
            if blur then Tween(blur, TI(0.9, S), { Size = BLUR_SIZE }) end

            Tween(BarTrack, TI(0.5, S), { BackgroundTransparency = 0 })
            Tween(BarFill, TI(0.5, S), { BackgroundTransparency = 0 })
            Tween(BarTip, TI(0.5, S), { BackgroundTransparency = 0.1 })
            Tween(Pct, TI(0.5, S), { TextTransparency = 0.2 })
            Tween(BarFill, TweenInfo.new(BAR_TIME, S, INOUT), { Size = UDim2.new(1, 0, 1, 0) })

            SpawnParticles()
            if not Step(0.15) then return end

            -- 2) Hai chữ C trượt vào
            local slide = TI(1.0, Q, OUT)
            Tween(CL, slide, { Position = UDim2.new(0.5, -EYE_GAP, 0, LOGO_Y), TextTransparency = 0 })
            Tween(CR, slide, { Position = UDim2.new(0.5, EYE_GAP, 0, LOGO_Y), TextTransparency = 0 })
            Tween(StL, slide, { Transparency = 0.5 })
            Tween(StR, slide, { Transparency = 0.5 })
            Tween(GradL, TweenInfo.new(4, Enum.EasingStyle.Linear), { Rotation = 225 })
            Tween(GradR, TweenInfo.new(4, Enum.EasingStyle.Linear), { Rotation = 225 })
            for _, g in ipairs(glowTargets) do
                Tween(g[1], TI(1.4), {
                    Size = UDim2.fromOffset(g[2], g[2]),
                    BackgroundTransparency = g[3]
                })
            end
            if not Step(0.8) then return end

            -- 3) Va chạm: con mắt bật ra + sóng xung kích + vòng quay
            Tween(Iris, TI(0.6, B, OUT), { Size = UDim2.fromOffset(30, 30) })
            Tween(IrisStroke, TI(0.4, S), { Transparency = 0 })

            Shock.Size = UDim2.fromOffset(20, 20)
            ShockStroke.Transparency = 0.1
            Tween(Shock, TI(0.9, Q, OUT), { Size = UDim2.fromOffset(300, 300) })
            Tween(ShockStroke, TI(0.9, S, OUT), { Transparency = 1 })

            Tween(RootScale, TI(0.12, QD, OUT), { Scale = scale * 1.05 })
            task.delay(0.12, function()
                if RootScale.Parent then Tween(RootScale, TI(0.55, B, OUT), { Scale = scale }) end
            end)

            Tween(Ring, TI(0.7, B, OUT), { Size = UDim2.fromOffset(78, 78) })
            Tween(RingStroke, TI(0.6, S), { Transparency = 0.1 })
            TweenService:Create(RingGrad, TweenInfo.new(2.2, Enum.EasingStyle.Linear, OUT, -1), { Rotation = 360 }):Play()

            -- 4) Tiêu đề hiện từng chữ
            for i, l in ipairs(letters) do
                task.delay(0.05 + (i - 1) * 0.045, function()
                    if l.Parent then
                        Tween(l, TI(0.55, Q, OUT), {
                            TextTransparency = 0,
                            Position = UDim2.fromOffset(0, 0),
                            TextColor3 = TEXT_MAIN
                        })
                    end
                end)
            end
            if Sub then
                task.delay(0.05 + #letters * 0.045, function()
                    if Sub.Parent then Tween(Sub, TI(0.6, S), { TextTransparency = 0.1 }) end
                end)
            end
            if not Step(0.75) then return end

            -- 5) Mắt nhìn trái -> phải -> giữa
            local look = TI(0.3, S, INOUT)
            Tween(Pupil, look, { Position = UDim2.new(0.5, -6, 0.5, 0) }); if not Step(0.38) then return end
            Tween(Pupil, look, { Position = UDim2.new(0.5, 6, 0.5, 0) });  if not Step(0.45) then return end
            Tween(Pupil, look, { Position = UDim2.fromScale(0.5, 0.5) });  if not Step(0.3) then return end

            -- 6) Chớp mắt
            Tween(Iris, TI(0.08, QD, IN), { Size = UDim2.fromOffset(30, 3) })
            if not Step(0.09) then return end
            Tween(Iris, TI(0.16, B, OUT), { Size = UDim2.fromOffset(30, 30) })
            if not Step(0.3) then return end

            -- Chờ thanh tiến trình chạm 100%
            while BarFill.Size.X.Scale < 0.995 and Step(0.03) do end
            Step(0.12)
        end

        local function Outro(fast)
            local d = fast and 0.3 or 0.6
            local fade = TI(d, QD, IN)

            -- Con mắt khép lại thành một chấm, rồi mọi thứ tan ra
            Tween(Iris, TweenInfo.new(d, B, IN), { Size = UDim2.fromOffset(0, 0) })
            Tween(IrisStroke, fade, { Transparency = 1 })
            Tween(Ring, fade, { Size = UDim2.fromOffset(0, 0) })
            Tween(RingStroke, fade, { Transparency = 1 })

            if not fast then
                Shock.Size = UDim2.fromOffset(10, 10)
                ShockStroke.Transparency = 0.2
                Tween(Shock, TI(0.6, Q, OUT), { Size = UDim2.fromOffset(420, 420) })
                Tween(ShockStroke, TI(0.6, S, OUT), { Transparency = 1 })
            end

            Tween(CL, fade, { TextTransparency = 1, Position = UDim2.new(0.5, -EYE_GAP * 0.55, 0, LOGO_Y) })
            Tween(CR, fade, { TextTransparency = 1, Position = UDim2.new(0.5, EYE_GAP * 0.55, 0, LOGO_Y) })
            Tween(StL, fade, { Transparency = 1 })
            Tween(StR, fade, { Transparency = 1 })
            for _, l in ipairs(letters) do Tween(l, fade, { TextTransparency = 1 }) end
            if Sub then Tween(Sub, fade, { TextTransparency = 1 }) end
            Tween(BarTrack, fade, { BackgroundTransparency = 1 })
            Tween(BarFill, fade, { BackgroundTransparency = 1 })
            Tween(BarTip, fade, { BackgroundTransparency = 1 })
            Tween(Pct, fade, { TextTransparency = 1 })
            Tween(Hint, fade, { TextTransparency = 1 })
            for _, g in ipairs(glowTargets) do Tween(g[1], fade, { BackgroundTransparency = 1 }) end
            Tween(RootScale, TI(d, Q, OUT), { Scale = scale * 1.12 })
            Tween(Dim, TI(d, S, IN), { BackgroundTransparency = 1 })
            if blur then Tween(blur, TI(d, S, IN), { Size = 0 }) end
            task.wait(d + 0.05)
        end

        Intro()
        Outro(skipped)
    end

    local ok, err = pcall(Run)
    if not ok then warn("[CyberVibe Intro] " .. tostring(err)) end
    Cleanup()
end
