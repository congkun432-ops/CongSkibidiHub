-- [[ SAND & DARK UI LIBRARY ]]
local Library = {}
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

-- Bảng màu (Color Palette)
local Colors = {
    MainDark = Color3.fromRGB(20, 20, 20),      -- Đen nền
    SecondDark = Color3.fromRGB(30, 30, 30),    -- Đen nhạt cho các panel
    SandAccent = Color3.fromRGB(225, 193, 110), -- Vàng cát (Sand)
    TextWhite = Color3.fromRGB(240, 240, 240),  -- Trắng ngà
    TextGray = Color3.fromRGB(150, 150, 150)    -- Xám chữ
}

function Library:CreateWindow(config)
    config = config or {}
    local WindowName = config.Name or "Sand UI Hub"

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "SandDark_UI"
    ScreenGui.ResetOnSpawn = false

    -- ==========================================
    -- MENU NHỎ (MINI MENU / MOBILE TOGGLE)
    -- ==========================================
    local MiniMenu = Instance.new("TextButton", ScreenGui)
    MiniMenu.Size = UDim2.new(0, 50, 0, 50)
    MiniMenu.Position = UDim2.new(0, 20, 0, 20)
    MiniMenu.BackgroundColor3 = Colors.SecondDark
    MiniMenu.Text = "S"
    MiniMenu.TextColor3 = Colors.SandAccent
    MiniMenu.Font = Enum.Font.GothamBold
    MiniMenu.TextSize = 24
    MiniMenu.Draggable = true
    MiniMenu.Visible = false -- Ẩn lúc đầu
    Instance.new("UICorner", MiniMenu).CornerRadius = UDim.new(0, 10)
    local MiniStroke = Instance.new("UIStroke", MiniMenu)
    MiniStroke.Color = Colors.SandAccent; MiniStroke.Thickness = 2

    -- ==========================================
    -- MENU LỚN (MAIN FRAME)
    -- ==========================================
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 500, 0, 350)
    MainFrame.Position = UDim2.new(0.5, -250, 0.5, -175)
    MainFrame.BackgroundColor3 = Colors.MainDark
    MainFrame.Active = true
    MainFrame.Draggable = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Color = Colors.SandAccent; MainStroke.Thickness = 1.5

    -- Tiêu đề
    local Title = Instance.new("TextLabel", MainFrame)
    Title.Size = UDim2.new(1, -60, 0, 40)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = WindowName
    Title.TextColor3 = Colors.SandAccent
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- Nút thu gọn (Minimize)
    local MinimizeBtn = Instance.new("TextButton", MainFrame)
    MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    MinimizeBtn.Position = UDim2.new(1, -40, 0, 5)
    MinimizeBtn.BackgroundColor3 = Colors.SecondDark
    MinimizeBtn.Text = "—"
    MinimizeBtn.TextColor3 = Colors.SandAccent
    MinimizeBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", MinimizeBtn).CornerRadius = UDim.new(0, 6)

    -- Hiệu ứng chuyển đổi Menu Lớn <-> Nhỏ
    MinimizeBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        MiniMenu.Visible = true
    end)

    MiniMenu.MouseButton1Click:Connect(function()
        MiniMenu.Visible = false
        MainFrame.Visible = true
    end)

    -- ==========================================
    -- KHUNG CHỨA TAB (CUỘN ĐƯỢC BÊN TRÁI)
    -- ==========================================
    local TabScroll = Instance.new("ScrollingFrame", MainFrame)
    TabScroll.Size = UDim2.new(0, 130, 1, -55)
    TabScroll.Position = UDim2.new(0, 10, 0, 45)
    TabScroll.BackgroundTransparency = 1
    TabScroll.ScrollBarThickness = 2
    TabScroll.ScrollBarImageColor3 = Colors.SandAccent
    TabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    
    local TabListLayout = Instance.new("UIListLayout", TabScroll)
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabScroll.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y)
    end)

    -- ==========================================
    -- KHUNG CHỨA NỘI DUNG (BÊN PHẢI)
    -- ==========================================
    local ContentContainer = Instance.new("Frame", MainFrame)
    ContentContainer.Size = UDim2.new(1, -160, 1, -55)
    ContentContainer.Position = UDim2.new(0, 150, 0, 45)
    ContentContainer.BackgroundTransparency = 1

    local Window = { Pages = {}, TabBtns = {} }

    function Window:CreateTab(name)
        -- Tạo nút Tab bên trái
        local TabBtn = Instance.new("TextButton", TabScroll)
        TabBtn.Size = UDim2.new(1, -10, 0, 35)
        TabBtn.BackgroundColor3 = Colors.SecondDark
        TabBtn.Text = name
        TabBtn.TextColor3 = Colors.TextGray
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 13
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        -- Tạo khung cuộn nội dung bên phải cho Tab này
        local PageScroll = Instance.new("ScrollingFrame", ContentContainer)
        PageScroll.Size = UDim2.new(1, 0, 1, 0)
        PageScroll.BackgroundTransparency = 1
        PageScroll.Visible = false
        PageScroll.ScrollBarThickness = 3
        PageScroll.ScrollBarImageColor3 = Colors.SandAccent
        PageScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

        local PageListLayout = Instance.new("UIListLayout", PageScroll)
        PageListLayout.Padding = UDim.new(0, 8)
        PageListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            PageScroll.CanvasSize = UDim2.new(0, 0, 0, PageListLayout.AbsoluteContentSize.Y + 10)
        end)

        -- Logic chuyển Tab
        TabBtn.MouseButton1Click:Connect(function()
            for _, page in pairs(Window.Pages) do page.Visible = false end
            for _, btn in pairs(Window.TabBtns) do
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.SecondDark, TextColor3 = Colors.TextGray}):Play()
            end
            PageScroll.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.SandAccent, TextColor3 = Colors.MainDark}):Play()
        end)

        if #Window.TabBtns == 0 then
            PageScroll.Visible = true
            TabBtn.BackgroundColor3 = Colors.SandAccent
            TabBtn.TextColor3 = Colors.MainDark
        end

        table.insert(Window.Pages, PageScroll)
        table.insert(Window.TabBtns, TabBtn)

        local TabElements = {}

        -- TÍNH NĂNG: SWITCH (TOGGLE)
        function TabElements:AddSwitch(title, default, callback)
            local SwitchFrame = Instance.new("Frame", PageScroll)
            SwitchFrame.Size = UDim2.new(1, -10, 0, 40)
            SwitchFrame.BackgroundColor3 = Colors.SecondDark
            Instance.new("UICorner", SwitchFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", SwitchFrame)
            Label.Size = UDim2.new(0.7, 0, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = title
            Label.TextColor3 = Colors.TextWhite
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local SwitchBG = Instance.new("Frame", SwitchFrame)
            SwitchBG.Size = UDim2.new(0, 40, 0, 20)
            SwitchBG.Position = UDim2.new(1, -50, 0.5, -10)
            SwitchBG.BackgroundColor3 = default and Colors.SandAccent or Colors.MainDark
            Instance.new("UICorner", SwitchBG).CornerRadius = UDim.new(1, 0)

            local Ball = Instance.new("Frame", SwitchBG)
            Ball.Size = UDim2.new(0, 16, 0, 16)
            Ball.Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            Ball.BackgroundColor3 = Colors.TextWhite
            Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)

            local ClickBtn = Instance.new("TextButton", SwitchFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            local state = default or false
            ClickBtn.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(Ball, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                TweenService:Create(SwitchBG, TweenInfo.new(0.2), {BackgroundColor3 = state and Colors.SandAccent or Colors.MainDark}):Play()
                if callback then callback(state) end
            end)
        end

        -- TÍNH NĂNG: TEXTBOX
        function TabElements:AddTextBox(title, placeholder, callback)
            local BoxFrame = Instance.new("Frame", PageScroll)
            BoxFrame.Size = UDim2.new(1, -10, 0, 40)
            BoxFrame.BackgroundColor3 = Colors.SecondDark
            Instance.new("UICorner", BoxFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", BoxFrame)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = title
            Label.TextColor3 = Colors.TextWhite
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Input = Instance.new("TextBox", BoxFrame)
            Input.Size = UDim2.new(0.4, 0, 0, 28)
            Input.Position = UDim2.new(1, -10, 0.5, -14)
            Input.AnchorPoint = Vector2.new(1, 0)
            Input.BackgroundColor3 = Colors.MainDark
            Input.TextColor3 = Colors.SandAccent
            Input.Text = ""
            Input.PlaceholderText = placeholder or "Nhập..."
            Input.Font = Enum.Font.Gotham
            Input.TextSize = 12
            Input.ClearTextOnFocus = false
            Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 4)

            Input.FocusLost:Connect(function()
                if callback then callback(Input.Text) end
            end)
        end

        -- TÍNH NĂNG: DROPDOWN
        function TabElements:AddDropdown(title, list, callback)
            local DropFrame = Instance.new("Frame", PageScroll)
            DropFrame.Size = UDim2.new(1, -10, 0, 40)
            DropFrame.BackgroundColor3 = Colors.SecondDark
            DropFrame.ClipsDescendants = true
            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", DropFrame)
            Label.Size = UDim2.new(1, -20, 0, 40)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = title .. " : " .. (list[1] or "Trống")
            Label.TextColor3 = Colors.TextWhite
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ToggleBtn = Instance.new("TextButton", DropFrame)
            ToggleBtn.Size = UDim2.new(1, 0, 0, 40)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""

            local ItemContainer = Instance.new("Frame", DropFrame)
            ItemContainer.Size = UDim2.new(1, 0, 1, -40)
            ItemContainer.Position = UDim2.new(0, 0, 0, 40)
            ItemContainer.BackgroundTransparency = 1

            local ItemListLayout = Instance.new("UIListLayout", ItemContainer)
            ItemListLayout.Padding = UDim.new(0, 2)
            
            local isOpen = false
            ToggleBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local targetSize = isOpen and UDim2.new(1, -10, 0, 40 + (#list * 30)) or UDim2.new(1, -10, 0, 40)
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = targetSize}):Play()
            end)

            for _, item in pairs(list) do
                local ItemBtn = Instance.new("TextButton", ItemContainer)
                ItemBtn.Size = UDim2.new(1, -20, 0, 28)
                ItemBtn.Position = UDim2.new(0, 10, 0, 0)
                ItemBtn.BackgroundColor3 = Colors.MainDark
                ItemBtn.Text = item
                ItemBtn.TextColor3 = Colors.SandAccent
                ItemBtn.Font = Enum.Font.Gotham
                ItemBtn.TextSize = 12
                Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 4)

                ItemBtn.MouseButton1Click:Connect(function()
                    Label.Text = title .. " : " .. item
                    isOpen = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
                    if callback then callback(item) end
                end)
            end
        end

        return TabElements
    end
    return Window
end

return Library
